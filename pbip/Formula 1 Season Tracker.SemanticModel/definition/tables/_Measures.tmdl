table _Measures
	lineageTag: 2480487f-24b9-4f80-8fe3-6ee3d2e8868b

	measure 'Total Points' =
			
			SUM ( Results[Points] )
		lineageTag: 5ec13562-e54a-4dcc-9a18-3311aa766a41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Podiums =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Position] <= 3
			)
		formatString: 0
		lineageTag: 1ebea7c0-964f-4f05-9f0c-6b316d0da5ec

	measure 'Avg Grid Position' =
			
			AVERAGE ( Results[Grid] )
		formatString: 0
		lineageTag: 43778a84-d5cb-43ec-bd2e-4d95032be4ae

	measure 'Fastest Laps' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[FLRank] = "1"
			)
		formatString: 0
		lineageTag: 3e045b0c-89f6-45b9-a8df-a130a48de746

	measure 'Race Wins' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Position] = 1
			)
		formatString: 0
		lineageTag: 5a9a0f7b-9716-4fd6-ae6b-72f5cc93ba0d

	measure 'Points Finishes' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Points] > 0
			)
		formatString: 0
		lineageTag: 505bd589-1cda-4976-9fb2-556f549869c8

	measure DNFs =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    NOT ( Results[Status] IN { "Finished" } ),
			    NOT ( CONTAINSSTRING ( Results[Status], "Lap" ) )
			)
		formatString: 0
		lineageTag: 8a39ca34-34a8-4fa5-a4f3-01477daad804

	measure 'Avg Finish Position' =
			
			AVERAGEX (
			    FILTER ( Results, NOT ISBLANK ( Results[Position] ) ),
			    Results[Position]
			)
		lineageTag: 29c07833-91cb-40e6-beeb-02a682ec38ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pole Positions' =
			
			CALCULATE (
			    COUNTROWS ( Qualifying ),
			    Qualifying[QualiPosition] = 1
			)
		formatString: 0
		lineageTag: ec496b02-87f8-4c04-930b-d8fd844e6a36

	measure 'Current Championship Position' =
			
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR LatestRound =
			    CALCULATE ( MAX ( StandingsSnapshot[Round] ), ALL ( Races ) )
			RETURN
			    CALCULATE (
			        MAX ( StandingsSnapshot[Position] ),
			        StandingsSnapshot[DriverId] = CurrentDriver,
			        StandingsSnapshot[Round] = LatestRound
			    )
		formatString: 0
		lineageTag: 8b5baa41-60dd-45c0-abd7-3e630cd10efd

	measure 'Points Gap to Leader' =
			
			VAR LatestRound =
			    CALCULATE ( MAX ( StandingsSnapshot[Round] ), ALL ( Races ) )
			VAR LeaderPoints =
			    CALCULATE (
			        MAX ( StandingsSnapshot[Points] ),
			        StandingsSnapshot[Position] = 1,
			        StandingsSnapshot[Round] = LatestRound,
			        ALL ( Drivers )
			    )
			VAR DriverPoints = [Total Points]
			RETURN
			    LeaderPoints - DriverPoints
		lineageTag: 2bab97c6-4f01-4aad-ab60-bce962269eda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Races Remaining' =
			
			VAR Today = TODAY ()
			VAR Total = CALCULATE ( DISTINCTCOUNT ( Races[Round] ), ALL ( Races ) )
			VAR Completed =
			    CALCULATE (
			        DISTINCTCOUNT ( Races[Round] ),
			        Races[Date] < Today,
			        ALL ( Races )
			    )
			RETURN
			    Total - Completed
		formatString: 0
		lineageTag: 4531ba26-3120-49d1-8325-2e474ac907e0

	measure 'Points Available' =
			
			VAR Remaining = [Races Remaining]
			VAR SprintCount = 6                          // adjust per actual 2026 calendar
			VAR SprintRemaining =
			    MAX ( 0, SprintCount - DIVIDE ( Remaining, 4 ) )    // rough estimate
			RETURN
			    Remaining * 25 + SprintRemaining * 8
		lineageTag: c7142754-7399-4af0-8f18-7dbe1b04fdff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Title Mathematically Clinched' =
			
			VAR Pos = [Current Championship Position]
			VAR Gap = -1 * [Points Gap to Leader]    // positive number = leader's lead
			VAR Available = [Points Available]
			RETURN
			    IF ( Pos = 1 && Gap > Available, "Yes", "No" )
		lineageTag: c046190f-97ff-4b57-b46e-c87cf10cae07

	measure 'Last 3 Races Points' =
			
			VAR LatestRound =
			    CALCULATE ( MAX ( Results[Round] ), ALL ( Results ) )
			RETURN
			    CALCULATE (
			        SUM ( Results[Points] ),
			        Results[Round] >= LatestRound - 2,
			        Results[Round] <= LatestRound
			    )
		lineageTag: 44dea100-1e1c-4f64-99d7-ebd5e17e8b1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Position Change vs Last Race' =
			
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR LatestRound =
			    CALCULATE ( MAX ( StandingsSnapshot[Round] ), ALL ( Races ) )
			VAR ThisPos =
			    CALCULATE (
			        MAX ( StandingsSnapshot[Position] ),
			        StandingsSnapshot[Round] = LatestRound,
			        StandingsSnapshot[DriverId] = CurrentDriver
			    )
			VAR PrevPos =
			    CALCULATE (
			        MAX ( StandingsSnapshot[Position] ),
			        StandingsSnapshot[Round] = LatestRound - 1,
			        StandingsSnapshot[DriverId] = CurrentDriver
			    )
			RETURN
			    PrevPos - ThisPos
		formatString: 0
		lineageTag: 6ab0f7a4-6dde-4277-888e-08f3778b43e0

	measure 'Cumulative Points' =
			
			VAR CurrentRound = MAX ( Races[Round] )
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			RETURN
			    CALCULATE (
			        SUM ( Results[Points] ),
			        Results[DriverId] = CurrentDriver,
			        Results[Round] <= CurrentRound,
			        ALL ( Races )
			    )
		lineageTag: f9951d27-5676-4171-98b3-60703db4e65c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Quali Position' =
			
			AVERAGE ( Qualifying[QualiPosition] )
		lineageTag: 5f9fb206-b631-4abc-8604-9675eb77b099

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quali vs Race Delta' =
			
			VAR AvgQ = [Avg Quali Position]
			VAR AvgR = [Avg Finish Position]
			RETURN
			    AvgQ - AvgR
		lineageTag: 3326792e-b1a0-47a9-a9c9-27f88e7157de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Teammate Race H2H Wins' =
			
			VAR ThisDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR ThisTeam =
			    CALCULATE (
			        SELECTEDVALUE ( Results[ConstructorId] ),
			        Results[DriverId] = ThisDriver
			    )
			RETURN
			    SUMX (
			        VALUES ( Results[Round] ),
			        VAR R = Results[Round]
			        VAR MyPos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[DriverId] = ThisDriver,
			                Results[Round] = R
			            )
			        VAR TeammatePos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[ConstructorId] = ThisTeam,
			                Results[DriverId] <> ThisDriver,
			                Results[Round] = R
			            )
			        RETURN
			            IF (
			                NOT ISBLANK ( MyPos )
			                    && NOT ISBLANK ( TeammatePos )
			                    && MyPos < TeammatePos,
			                1,
			                0
			            )
			    )
		formatString: 0
		lineageTag: 524b3634-e06f-40df-b215-99528597035d

	measure 'Teammate Race H2H Losses' =
			
			VAR ThisDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR ThisTeam =
			    CALCULATE (
			        SELECTEDVALUE ( Results[ConstructorId] ),
			        Results[DriverId] = ThisDriver
			    )
			RETURN
			    SUMX (
			        VALUES ( Results[Round] ),
			        VAR R = Results[Round]
			        VAR MyPos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[DriverId] = ThisDriver,
			                Results[Round] = R
			            )
			        VAR TeammatePos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[ConstructorId] = ThisTeam,
			                Results[DriverId] <> ThisDriver,
			                Results[Round] = R
			            )
			        RETURN
			            IF (
			                NOT ISBLANK ( MyPos )
			                    && NOT ISBLANK ( TeammatePos )
			                    && MyPos > TeammatePos,
			                1,
			                0
			            )
			    )
		formatString: 0
		lineageTag: 13dc7ab5-c530-4190-b726-5eaf8b54f4c1

	measure 'Teammate H2H Display' =
			
			[Teammate Race H2H Wins] & " - " & [Teammate Race H2H Losses]
		lineageTag: 9a9e10ae-a18d-437f-8961-a20754c36027

	measure 'Overview Dashboard HTML' =
			
			
			// ---------- CORE FACTS ----------
			VAR LatestRound =
			    CALCULATE ( MAX ( StandingsSnapshot[Round] ), ALL ( StandingsSnapshot ) )
			VAR TotalRounds =
			    CALCULATE ( DISTINCTCOUNT ( Races[Round] ), ALL ( Races ) )
			VAR LatestRaceName =
			    CALCULATE (
			        MAX ( Races[RaceName] ),
			        Races[Round] = LatestRound,
			        ALL ( Races )
			    )
			VAR LatestCountry =
			    CALCULATE (
			        MAX ( Races[Country] ),
			        Races[Round] = LatestRound,
			        ALL ( Races )
			    )
			VAR RacesRem = TotalRounds - LatestRound
			
			// ---------- LEADER ----------
			VAR LeaderId =
			    CALCULATE (
			        MAX ( StandingsSnapshot[DriverId] ),
			        StandingsSnapshot[Round] = LatestRound,
			        StandingsSnapshot[Position] = 1,
			        ALL ( StandingsSnapshot )
			    )
			VAR LeaderName =
			    LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], LeaderId )
			VAR LeaderPoints =
			    CALCULATE (
			        MAX ( StandingsSnapshot[Points] ),
			        StandingsSnapshot[Round] = LatestRound,
			        StandingsSnapshot[Position] = 1,
			        ALL ( StandingsSnapshot )
			    )
			VAR P2Points =
			    CALCULATE (
			        MAX ( StandingsSnapshot[Points] ),
			        StandingsSnapshot[Round] = LatestRound,
			        StandingsSnapshot[Position] = 2,
			        ALL ( StandingsSnapshot )
			    )
			VAR P1P2Gap = LeaderPoints - P2Points
			
			// ---------- DRIVER STANDINGS TABLE ----------
			VAR DriverStandings =
			    CALCULATETABLE (
			        SUMMARIZE (
			            StandingsSnapshot,
			            StandingsSnapshot[DriverId],
			            StandingsSnapshot[ConstructorId],
			            StandingsSnapshot[Position],
			            StandingsSnapshot[Points],
			            StandingsSnapshot[Wins]
			        ),
			        StandingsSnapshot[Round] = LatestRound,
			        ALL ( StandingsSnapshot )
			    )
			VAR DriverRows =
			    ADDCOLUMNS (
			        DriverStandings,
			        "@Name",
			            LOOKUPVALUE (
			                Drivers[DriverName],
			                Drivers[DriverId], StandingsSnapshot[DriverId]
			            ),
			        "@Code",
			            LOOKUPVALUE (
			                Drivers[DriverCode],
			                Drivers[DriverId], StandingsSnapshot[DriverId]
			            ),
			        "@TeamName",
			            LOOKUPVALUE (
			                Constructors[ConstructorName],
			                Constructors[ConstructorId], StandingsSnapshot[ConstructorId]
			            ),
			        "@Color",
			            LOOKUPVALUE (
			                Constructors[TeamColor],
			                Constructors[ConstructorId], StandingsSnapshot[ConstructorId]
			            )
			    )
			VAR DriverRowsHTML =
			    CONCATENATEX (
			        DriverRows,
			        "<div class='row' style='border-left:4px solid " & [@Color] & "'>"
			            & "<div class='pos'>" & StandingsSnapshot[Position] & "</div>"
			            & "<div class='code'>" & IF ( ISBLANK ( [@Code] ), "—", [@Code] ) & "</div>"
			            & "<div class='dname'>"
			                & "<div class='dname-main'>" & [@Name] & "</div>"
			                & "<div class='dname-sub'>" & [@TeamName] & "</div>"
			            & "</div>"
			            & "<div class='wins'>" & StandingsSnapshot[Wins] & "W</div>"
			            & "<div class='pts'>" & FORMAT ( StandingsSnapshot[Points], "0" ) & "</div>"
			            & "<div class='gap'>"
			                & IF ( StandingsSnapshot[Position] = 1, "LEADER",
			                    "-" & FORMAT ( LeaderPoints - StandingsSnapshot[Points], "0" ) )
			            & "</div>"
			        & "</div>",
			        "",
			        StandingsSnapshot[Position], ASC
			    )
			
			// ---------- CONSTRUCTOR STANDINGS ----------
			VAR ConstructorTotals =
			    ADDCOLUMNS (
			        VALUES ( Constructors[ConstructorId] ),
			        "@CName",
			            CALCULATE ( MAX ( Constructors[ConstructorName] ) ),
			        "@CColor",
			            CALCULATE ( MAX ( Constructors[TeamColor] ) ),
			        "@CPoints",
			            CALCULATE (
			                SUM ( Results[Points] ),
			                ALLEXCEPT ( Constructors, Constructors[ConstructorId] )
			            )
			    )
			VAR ConstructorFiltered =
			    FILTER ( ConstructorTotals, NOT ISBLANK ( [@CPoints] ) && [@CPoints] > 0 )
			VAR MaxConstructorPoints =
			    MAXX ( ConstructorFiltered, [@CPoints] )
			VAR ConstructorRowsHTML =
			    CONCATENATEX (
			        ConstructorFiltered,
			        VAR BarPct = DIVIDE ( [@CPoints], MaxConstructorPoints ) * 100
			        RETURN
			            "<div class='crow'>"
			                & "<div class='cname'>" & [@CName] & "</div>"
			                & "<div class='cbar-wrap'>"
			                    & "<div class='cbar' style='width:" & FORMAT ( BarPct, "0.0" )
			                        & "%;background:" & [@CColor] & ";'></div>"
			                & "</div>"
			                & "<div class='cpts'>" & FORMAT ( [@CPoints], "0" ) & "</div>"
			            & "</div>",
			        "",
			        [@CPoints], DESC
			    )
			
			// ---------- RECENT RACE RESULTS ----------
			VAR RecentRaces =
			    FILTER (
			        ALL ( Races[Round], Races[RaceName], Races[Country], Races[Date] ),
			        Races[Round] >= LatestRound - 2 && Races[Round] <= LatestRound
			    )
			VAR RecentRowsHTML =
			    CONCATENATEX (
			        RecentRaces,
			        VAR R = Races[Round]
			        VAR P1 =
			            CALCULATE (
			                MAX ( Results[DriverName] ),
			                Results[Round] = R,
			                Results[Position] = 1
			            )
			        VAR P1Team =
			            CALCULATE (
			                MAX ( Constructors[TeamColor] ),
			                Results[Round] = R,
			                Results[Position] = 1
			            )
			        VAR P2 =
			            CALCULATE (
			                MAX ( Results[DriverName] ),
			                Results[Round] = R,
			                Results[Position] = 2
			            )
			        VAR P3 =
			            CALCULATE (
			                MAX ( Results[DriverName] ),
			                Results[Round] = R,
			                Results[Position] = 3
			            )
			        RETURN
			            IF ( NOT ISBLANK ( P1 ),
			                "<div class='race'>"
			                    & "<div class='rhead'>"
			                        & "<span class='rrn'>R" & R & "</span>"
			                        & "<span class='rname'>" & Races[Country] & "</span>"
			                    & "</div>"
			                    & "<div class='podium-mini'>"
			                        & "<div class='pp pp1' style='border-left:3px solid " & IF ( ISBLANK ( P1Team ), "#888", P1Team ) & "'>"
			                            & "<span class='pn pn1'>1</span>"
			                            & "<span class='pname'>" & P1 & "</span>"
			                        & "</div>"
			                        & "<div class='pp pp2'>"
			                            & "<span class='pn pn2'>2</span>"
			                            & "<span class='pname'>" & IF ( ISBLANK ( P2 ), "—", P2 ) & "</span>"
			                        & "</div>"
			                        & "<div class='pp pp3'>"
			                            & "<span class='pn pn3'>3</span>"
			                            & "<span class='pname'>" & IF ( ISBLANK ( P3 ), "—", P3 ) & "</span>"
			                        & "</div>"
			                    & "</div>"
			                & "</div>",
			                ""
			            ),
			        "",
			        Races[Round], DESC
			    )
			
			// ---------- ASSEMBLE PAGE ----------
			RETURN
			"<style>"
			& ".dash *{box-sizing:border-box;margin:0;padding:0;font-family:'Inter','Segoe UI',-apple-system,sans-serif;-webkit-font-smoothing:antialiased}"
			& ".dash{display:grid;grid-template-columns:repeat(12,1fr);grid-gap:14px;padding:18px;background:#0a0a0d;min-height:100vh;color:#ffffff}"
			
			// HEADER
			& ".dash .header{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:6px 4px 14px;border-bottom:1px solid #2a2a30}"
			& ".dash .title{display:flex;align-items:center;gap:14px;color:#ffffff}"
			& ".dash .title .bar{width:5px;height:32px;background:#FF1801;border-radius:2px;display:inline-block}"
			& ".dash .title h1{font-size:22px;font-weight:800;letter-spacing:0.05em;color:#ffffff;margin:0}"
			& ".dash .title h1 .red{color:#FF1801}"
			& ".dash .roundbox{text-align:right;font-size:11px;color:#aaaaaa;letter-spacing:0.1em;text-transform:uppercase}"
			& ".dash .roundbox .big{font-size:18px;color:#ffffff;font-weight:700;letter-spacing:0.02em;margin-top:2px}"
			
			// KPI CARDS
			& ".dash .kpi{background:linear-gradient(135deg,#1a1a1f,#15151a);border:1px solid #2a2a30;border-radius:8px;padding:16px 18px;position:relative;overflow:hidden;color:#ffffff}"
			& ".dash .kpi .accent-bar{position:absolute;left:0;top:0;width:4px;height:100%}"
			& ".dash .kpi.k1 .accent-bar{background:#FF1801}"
			& ".dash .kpi.k2 .accent-bar{background:#FFCC00}"
			& ".dash .kpi.k3 .accent-bar{background:#27F4D2}"
			& ".dash .kpi.k4 .accent-bar{background:#3671C6}"
			& ".dash .kpi .label{font-size:10px;color:#aaaaaa;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:8px;font-weight:600}"
			& ".dash .kpi .value{font-size:24px;font-weight:800;letter-spacing:-0.02em;line-height:1.1;color:#ffffff}"
			& ".dash .kpi .sub{font-size:11px;color:#aaaaaa;margin-top:6px}"
			
			// PANELS
			& ".dash .panel{background:#15151a;border:1px solid #2a2a30;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;color:#ffffff}"
			& ".dash .panel-head{padding:12px 16px;border-bottom:1px solid #2a2a30;display:flex;justify-content:space-between;align-items:center;background:#1a1a1f}"
			& ".dash .panel-head h2{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#cccccc;font-weight:700;margin:0;display:flex;align-items:center}"
			& ".dash .panel-head .accent-dot{width:8px;height:8px;background:#FF1801;border-radius:50%;display:inline-block;margin-right:8px;animation:f1pulse 2s infinite}"
			& ".dash .panel-head .meta{font-size:10px;color:#888888}"
			& "@keyframes f1pulse{0%,100%{opacity:1}50%{opacity:0.4}}"
			& ".dash .panel-body{padding:0;overflow-y:auto;color:#ffffff}"
			
			// STANDINGS ROWS
			& ".dash .standings{display:flex;flex-direction:column}"
			& ".dash .row{display:grid;grid-template-columns:36px 50px 1fr 50px 70px 70px;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #1f1f24;transition:background 0.15s;color:#ffffff}"
			& ".dash .row:hover{background:#1f1f24}"
			& ".dash .row .pos{font-weight:800;font-size:18px;color:#ffffff;text-align:center}"
			& ".dash .row .code{font-family:'JetBrains Mono','Consolas',monospace;font-size:11px;color:#cccccc;letter-spacing:0.05em;background:#0a0a0d;padding:3px 6px;border-radius:3px;text-align:center}"
			& ".dash .row .dname{display:flex;flex-direction:column;gap:2px}"
			& ".dash .row .dname .dname-main{font-size:14px;font-weight:600;color:#ffffff}"
			& ".dash .row .dname .dname-sub{font-size:10px;color:#aaaaaa;font-weight:500;letter-spacing:0.03em}"
			& ".dash .row .wins{font-size:11px;color:#FFCC00;font-weight:700;text-align:right}"
			& ".dash .row .pts{font-size:16px;font-weight:800;color:#ffffff;text-align:right;font-variant-numeric:tabular-nums}"
			& ".dash .row .gap{font-size:11px;color:#aaaaaa;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:0.03em}"
			
			// CONSTRUCTORS
			& ".dash .constructors{padding:14px 16px;display:flex;flex-direction:column;gap:10px}"
			& ".dash .crow{display:grid;grid-template-columns:120px 1fr 70px;align-items:center;gap:12px}"
			& ".dash .crow .cname{font-size:12px;font-weight:600;color:#ffffff}"
			& ".dash .crow .cbar-wrap{height:22px;background:#0a0a0d;border-radius:3px;overflow:hidden;position:relative}"
			& ".dash .crow .cbar{height:100%;border-radius:3px;transition:width 0.6s cubic-bezier(0.16,1,0.3,1)}"
			& ".dash .crow .cpts{font-size:14px;font-weight:800;text-align:right;color:#ffffff;font-variant-numeric:tabular-nums}"
			
			// RECENT RACES
			& ".dash .recent{padding:14px 16px;display:flex;flex-direction:column;gap:14px}"
			& ".dash .race{padding:12px 14px;background:#0f0f12;border-left:3px solid #FF1801;border-radius:3px;color:#ffffff}"
			& ".dash .rhead{margin-bottom:8px;display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:0.05em;text-transform:uppercase}"
			& ".dash .rrn{color:#FF1801;font-weight:800}"
			& ".dash .rname{color:#ffffff;font-weight:600}"
			& ".dash .podium-mini{display:flex;flex-direction:column;gap:5px}"
			& ".dash .pp{display:flex;align-items:center;gap:10px;font-size:12px;padding:6px 10px;border-radius:3px;background:#15151a;color:#ffffff}"
			& ".dash .pp1{background:linear-gradient(90deg,rgba(255,204,0,0.18),rgba(255,204,0,0.04))}"
			& ".dash .pp2{background:rgba(255,255,255,0.04)}"
			& ".dash .pp3{background:rgba(205,127,50,0.08)}"
			& ".dash .pname{color:#ffffff;font-weight:500}"
			& ".dash .pn{font-weight:800;font-size:11px;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;flex-shrink:0}"
			& ".dash .pn1{background:#FFCC00;color:#000000}"
			& ".dash .pn2{background:#C0C0C0;color:#000000}"
			& ".dash .pn3{background:#CD7F32;color:#ffffff}"
			
			& ".dash .empty{padding:40px;text-align:center;color:#888888;font-size:13px}"
			& "</style>"
			
			& "<div class='dash'>"
			
			// HEADER
			& "<div class='header'>"
			    & "<div class='title'>"
			        & "<span class='bar'></span>"
			        & "<h1>FORMULA <span class='red'>1</span> &nbsp;·&nbsp; 2026 SEASON</h1>"
			    & "</div>"
			    & "<div class='roundbox'>"
			        & "Latest Round"
			        & "<div class='big'>R" & LatestRound & " / " & TotalRounds & " · " & UPPER ( IF ( ISBLANK ( LatestCountry ), "—", LatestCountry ) ) & "</div>"
			    & "</div>"
			& "</div>"
			
			// KPIS
			& "<div class='kpi k1' style='grid-column:1/4'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Championship Leader</div>"
			    & "<div class='value'>" & IF ( ISBLANK ( LeaderName ), "—", LeaderName ) & "</div>"
			    & "<div class='sub'>" & FORMAT ( LeaderPoints, "0" ) & " points</div>"
			& "</div>"
			
			& "<div class='kpi k2' style='grid-column:4/7'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Lead over P2</div>"
			    & "<div class='value'>+" & FORMAT ( P1P2Gap, "0" ) & "</div>"
			    & "<div class='sub'>points</div>"
			& "</div>"
			
			& "<div class='kpi k3' style='grid-column:7/10'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Races Remaining</div>"
			    & "<div class='value'>" & RacesRem & "</div>"
			    & "<div class='sub'>of " & TotalRounds & " round season</div>"
			& "</div>"
			
			& "<div class='kpi k4' style='grid-column:10/13'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Last Race</div>"
			    & "<div class='value' style='font-size:18px'>" & IF ( ISBLANK ( LatestRaceName ), "Season not started", LatestRaceName ) & "</div>"
			    & "<div class='sub'>" & UPPER ( IF ( ISBLANK ( LatestCountry ), "—", LatestCountry ) ) & "</div>"
			& "</div>"
			
			// DRIVER STANDINGS
			& "<div class='panel' style='grid-column:1/8;grid-row:3/5'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Driver Standings</h2><span class='meta'>AS OF ROUND " & LatestRound & "</span></div>"
			    & "<div class='panel-body standings'>"
			        & IF ( ISBLANK ( DriverRowsHTML ),
			            "<div class='empty'>No race data yet for the 2026 season.</div>",
			            DriverRowsHTML )
			    & "</div>"
			& "</div>"
			
			// CONSTRUCTORS
			& "<div class='panel' style='grid-column:8/13;grid-row:3/4'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Constructors Championship</h2></div>"
			    & "<div class='panel-body constructors'>"
			        & IF ( ISBLANK ( ConstructorRowsHTML ),
			            "<div class='empty'>Awaiting first race.</div>",
			            ConstructorRowsHTML )
			    & "</div>"
			& "</div>"
			
			// RECENT RACES
			& "<div class='panel' style='grid-column:8/13;grid-row:4/5'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Recent Race Winners</h2></div>"
			    & "<div class='panel-body recent'>"
			        & IF ( ISBLANK ( RecentRowsHTML ),
			            "<div class='empty'>Awaiting first race.</div>",
			            RecentRowsHTML )
			    & "</div>"
			& "</div>"
			
			& "</div>"
		lineageTag: 6b5124b2-e810-414d-8cf9-6724464b6d21

	column Column
		dataType: string
		isHidden
		lineageTag: c0a436af-4228-4c5e-8543-adbb6127f5d1
		summarizeBy: none
		sourceColumn: Column

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table


table _Measures
	lineageTag: 2480487f-24b9-4f80-8fe3-6ee3d2e8868b

	measure 'Total Points' =
			
			SUM ( Results[Points] )
		lineageTag: 5ec13562-e54a-4dcc-9a18-3311aa766a41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Podiums =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Position] <= 3
			)
		formatString: 0
		lineageTag: 1ebea7c0-964f-4f05-9f0c-6b316d0da5ec

	measure 'Avg Grid Position' =
			
			AVERAGE ( Results[Grid] )
		formatString: 0
		lineageTag: 43778a84-d5cb-43ec-bd2e-4d95032be4ae

	measure 'Fastest Laps' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[FLRank] = "1"
			)
		formatString: 0
		lineageTag: 3e045b0c-89f6-45b9-a8df-a130a48de746

	measure 'Race Wins' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Position] = 1
			)
		formatString: 0
		lineageTag: 5a9a0f7b-9716-4fd6-ae6b-72f5cc93ba0d

	measure 'Points Finishes' =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    Results[Points] > 0
			)
		formatString: 0
		lineageTag: 505bd589-1cda-4976-9fb2-556f549869c8

	measure DNFs =
			
			CALCULATE (
			    COUNTROWS ( Results ),
			    NOT ( Results[Status] IN { "Finished" } ),
			    NOT ( CONTAINSSTRING ( Results[Status], "Lap" ) )
			)
		formatString: 0
		lineageTag: 8a39ca34-34a8-4fa5-a4f3-01477daad804

	measure 'Avg Finish Position' =
			
			AVERAGEX (
			    FILTER ( Results, NOT ISBLANK ( Results[Position] ) ),
			    Results[Position]
			)
		lineageTag: 29c07833-91cb-40e6-beeb-02a682ec38ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pole Positions' =
			
			CALCULATE (
			    COUNTROWS ( Qualifying ),
			    Qualifying[QualiPosition] = 1
			)
		formatString: 0
		lineageTag: ec496b02-87f8-4c04-930b-d8fd844e6a36

	measure 'Current Championship Position' =
			
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR LatestRound =
			    CALCULATE ( MAX ( 'Standings Snapshot'[Round] ), ALL ( Races ) )
			RETURN
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Position] ),
			        'Standings Snapshot'[DriverId] = CurrentDriver,
			        'Standings Snapshot'[Round] = LatestRound
			    )
		formatString: 0
		lineageTag: 8b5baa41-60dd-45c0-abd7-3e630cd10efd

	measure 'Points Gap to Leader' =
			
			VAR LatestRound =
			    CALCULATE ( MAX ( 'Standings Snapshot'[Round] ), ALL ( Races ) )
			VAR LeaderPoints =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Points] ),
			        'Standings Snapshot'[Position] = 1,
			        'Standings Snapshot'[Round] = LatestRound,
			        ALL ( Drivers )
			    )
			VAR DriverPoints = [Total Points]
			RETURN
			    LeaderPoints - DriverPoints
		lineageTag: 2bab97c6-4f01-4aad-ab60-bce962269eda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Races Remaining' =
			
			VAR Today = TODAY ()
			VAR Total = CALCULATE ( DISTINCTCOUNT ( Races[Round] ), ALL ( Races ) )
			VAR Completed =
			    CALCULATE (
			        DISTINCTCOUNT ( Races[Round] ),
			        Races[Date] < Today,
			        ALL ( Races )
			    )
			RETURN
			    Total - Completed
		formatString: 0
		lineageTag: 4531ba26-3120-49d1-8325-2e474ac907e0

	measure 'Points Available' =
			
			VAR Remaining = [Races Remaining]
			VAR SprintCount = 6                          // adjust per actual 2026 calendar
			VAR SprintRemaining =
			    MAX ( 0, SprintCount - DIVIDE ( Remaining, 4 ) )    // rough estimate
			RETURN
			    Remaining * 25 + SprintRemaining * 8
		lineageTag: c7142754-7399-4af0-8f18-7dbe1b04fdff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Title Mathematically Clinched' =
			
			VAR Pos = [Current Championship Position]
			VAR Gap = -1 * [Points Gap to Leader]    // positive number = leader's lead
			VAR Available = [Points Available]
			RETURN
			    IF ( Pos = 1 && Gap > Available, "Yes", "No" )
		lineageTag: c046190f-97ff-4b57-b46e-c87cf10cae07

	measure 'Last 3 Races Points' =
			
			VAR LatestRound =
			    CALCULATE ( MAX ( Results[Round] ), ALL ( Results ) )
			RETURN
			    CALCULATE (
			        SUM ( Results[Points] ),
			        Results[Round] >= LatestRound - 2,
			        Results[Round] <= LatestRound
			    )
		lineageTag: 44dea100-1e1c-4f64-99d7-ebd5e17e8b1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Position Change vs Last Race' =
			
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR LatestRound =
			    CALCULATE ( MAX ( 'Standings Snapshot'[Round] ), ALL ( Races ) )
			VAR ThisPos =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Position] ),
			        'Standings Snapshot'[Round] = LatestRound,
			        'Standings Snapshot'[DriverId] = CurrentDriver
			    )
			VAR PrevPos =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Position] ),
			        'Standings Snapshot'[Round] = LatestRound - 1,
			        'Standings Snapshot'[DriverId] = CurrentDriver
			    )
			RETURN
			    PrevPos - ThisPos
		formatString: 0
		lineageTag: 6ab0f7a4-6dde-4277-888e-08f3778b43e0

	measure 'Cumulative Points' =
			
			VAR CurrentRound = MAX ( Races[Round] )
			VAR CurrentDriver = SELECTEDVALUE ( Drivers[DriverId] )
			RETURN
			    CALCULATE (
			        SUM ( Results[Points] ),
			        Results[DriverId] = CurrentDriver,
			        Results[Round] <= CurrentRound,
			        ALL ( Races )
			    )
		lineageTag: f9951d27-5676-4171-98b3-60703db4e65c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Quali Position' =
			
			AVERAGE ( Qualifying[QualiPosition] )
		lineageTag: 5f9fb206-b631-4abc-8604-9675eb77b099

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quali vs Race Delta' =
			
			VAR AvgQ = [Avg Quali Position]
			VAR AvgR = [Avg Finish Position]
			RETURN
			    AvgQ - AvgR
		lineageTag: 3326792e-b1a0-47a9-a9c9-27f88e7157de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Teammate Race H2H Wins' =
			
			VAR ThisDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR ThisTeam =
			    CALCULATE (
			        SELECTEDVALUE ( Results[ConstructorId] ),
			        Results[DriverId] = ThisDriver
			    )
			RETURN
			    SUMX (
			        VALUES ( Results[Round] ),
			        VAR R = Results[Round]
			        VAR MyPos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[DriverId] = ThisDriver,
			                Results[Round] = R
			            )
			        VAR TeammatePos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[ConstructorId] = ThisTeam,
			                Results[DriverId] <> ThisDriver,
			                Results[Round] = R
			            )
			        RETURN
			            IF (
			                NOT ISBLANK ( MyPos )
			                    && NOT ISBLANK ( TeammatePos )
			                    && MyPos < TeammatePos,
			                1,
			                0
			            )
			    )
		formatString: 0
		lineageTag: 524b3634-e06f-40df-b215-99528597035d

	measure 'Teammate Race H2H Losses' =
			
			VAR ThisDriver = SELECTEDVALUE ( Drivers[DriverId] )
			VAR ThisTeam =
			    CALCULATE (
			        SELECTEDVALUE ( Results[ConstructorId] ),
			        Results[DriverId] = ThisDriver
			    )
			RETURN
			    SUMX (
			        VALUES ( Results[Round] ),
			        VAR R = Results[Round]
			        VAR MyPos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[DriverId] = ThisDriver,
			                Results[Round] = R
			            )
			        VAR TeammatePos =
			            CALCULATE (
			                MAX ( Results[Position] ),
			                Results[ConstructorId] = ThisTeam,
			                Results[DriverId] <> ThisDriver,
			                Results[Round] = R
			            )
			        RETURN
			            IF (
			                NOT ISBLANK ( MyPos )
			                    && NOT ISBLANK ( TeammatePos )
			                    && MyPos > TeammatePos,
			                1,
			                0
			            )
			    )
		formatString: 0
		lineageTag: 13dc7ab5-c530-4190-b726-5eaf8b54f4c1

	measure 'Teammate H2H Display' =
			
			[Teammate Race H2H Wins] & " - " & [Teammate Race H2H Losses]
		lineageTag: 9a9e10ae-a18d-437f-8961-a20754c36027

	measure 'Overview HTML' =
			
			
			// ---------- CORE FACTS ----------
			VAR LatestRound =
			    CALCULATE ( MAX ( 'Standings Snapshot'[Round] ), ALL ( 'Standings Snapshot' ) )
			VAR TotalRounds =
			    CALCULATE ( DISTINCTCOUNT ( Races[Round] ), ALL ( Races ) )
			VAR LatestRaceName =
			    CALCULATE ( MAX ( Races[RaceName] ), Races[Round] = LatestRound, ALL ( Races ) )
			VAR LatestCountry =
			    CALCULATE ( MAX ( Races[Country] ), Races[Round] = LatestRound, ALL ( Races ) )
			VAR RacesRem = TotalRounds - LatestRound
			
			// ---------- LEADER ----------
			VAR LeaderId =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[DriverId] ),
			        'Standings Snapshot'[Round] = LatestRound,
			        'Standings Snapshot'[Position] = 1,
			        ALL ( 'Standings Snapshot' )
			    )
			VAR LeaderName =
			    LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], LeaderId )
			VAR LeaderPoints =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Points] ),
			        'Standings Snapshot'[Round] = LatestRound,
			        'Standings Snapshot'[Position] = 1,
			        ALL ( 'Standings Snapshot' )
			    )
			VAR P2Points =
			    CALCULATE (
			        MAX ( 'Standings Snapshot'[Points] ),
			        'Standings Snapshot'[Round] = LatestRound,
			        'Standings Snapshot'[Position] = 2,
			        ALL ( 'Standings Snapshot' )
			    )
			VAR P1P2Gap = LeaderPoints - P2Points
			
			// ---------- DRIVER STANDINGS ----------
			VAR DriverStandings =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Standings Snapshot',
			            'Standings Snapshot'[DriverId],
			            'Standings Snapshot'[ConstructorId],
			            'Standings Snapshot'[Position],
			            'Standings Snapshot'[Points],
			            'Standings Snapshot'[Wins]
			        ),
			        'Standings Snapshot'[Round] = LatestRound,
			        ALL ( 'Standings Snapshot' )
			    )
			VAR DriverRows =
			    ADDCOLUMNS (
			        DriverStandings,
			        "@Name",
			            LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], 'Standings Snapshot'[DriverId] ),
			        "@Code",
			            LOOKUPVALUE ( Drivers[DriverCode], Drivers[DriverId], 'Standings Snapshot'[DriverId] ),
			        "@Number",
			            LOOKUPVALUE ( Drivers[DriverNumber], Drivers[DriverId], 'Standings Snapshot'[DriverId] ),
			        "@Nat",
			            LOOKUPVALUE ( Drivers[DriverNationality], Drivers[DriverId], 'Standings Snapshot'[DriverId] ),
			        "@TeamName",
			            LOOKUPVALUE ( Constructors[ConstructorName], Constructors[ConstructorId], 'Standings Snapshot'[ConstructorId] ),
			        "@Color",
			            LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], 'Standings Snapshot'[ConstructorId] ),
			        "@Podiums",
			            VAR DId = 'Standings Snapshot'[DriverId]
			            RETURN
			                CALCULATE (
			                    COUNTROWS ( Results ),
			                    Results[DriverId] = DId,
			                    Results[Position] <= 3
			                ),
			        "@AvgFinish",
			            VAR DId = 'Standings Snapshot'[DriverId]
			            RETURN
			                CALCULATE (
			                    AVERAGEX ( FILTER ( Results, NOT ISBLANK ( Results[Position] ) ), Results[Position] ),
			                    Results[DriverId] = DId
			                ),
			        "@AvgGrid",
			            VAR DId = 'Standings Snapshot'[DriverId]
			            RETURN
			                CALCULATE (
			                    AVERAGE ( Results[Grid] ),
			                    Results[DriverId] = DId
			                ),
			        "@DNFs",
			            VAR DId = 'Standings Snapshot'[DriverId]
			            RETURN
			                CALCULATE (
			                    COUNTROWS ( Results ),
			                    Results[DriverId] = DId,
			                    NOT ( Results[Status] IN { "Finished" } ),
			                    NOT ( CONTAINSSTRING ( Results[Status], "Lap" ) )
			                ),
			        "@FLs",
			            VAR DId = 'Standings Snapshot'[DriverId]
			            RETURN
			                CALCULATE (
			                    COUNTROWS ( Results ),
			                    Results[DriverId] = DId,
			                    Results[FLRank] = "1"
			                )
			    )
			VAR DriverRowsHTML =
			    CONCATENATEX (
			        DriverRows,
			        VAR DelayMs = 'Standings Snapshot'[Position] * 40
			        VAR GapTxt = IF ( 'Standings Snapshot'[Position] = 1, "LEADER",
			                "-" & FORMAT ( LeaderPoints - 'Standings Snapshot'[Points], "0" ) )
			        RETURN
			        "<div class='row' style='border-left:4px solid " & [@Color]
			            & ";animation-delay:" & DelayMs & "ms'>"
			            & "<div class='pos'>" & 'Standings Snapshot'[Position] & "</div>"
			            & "<div class='code'>" & IF ( ISBLANK ( [@Code] ), "—", [@Code] ) & "</div>"
			            & "<div class='dname'>"
			                & "<div class='dname-main'>" & [@Name] & "</div>"
			                & "<div class='dname-sub'>" & [@TeamName] & "</div>"
			            & "</div>"
			            & "<div class='wins'>" & 'Standings Snapshot'[Wins] & "W</div>"
			            & "<div class='pts'>" & FORMAT ( 'Standings Snapshot'[Points], "0" ) & "</div>"
			            & "<div class='gap'>" & GapTxt & "</div>"
			            & "<div class='tooltip' style='border-top:3px solid " & [@Color] & "'>"
			                & "<div class='tt-head'>"
			                    & "<div class='tt-num' style='background:" & [@Color] & "'>" & IF ( ISBLANK ( [@Number] ), "—", [@Number] ) & "</div>"
			                    & "<div class='tt-id'>"
			                        & "<div class='tt-name'>" & [@Name] & "</div>"
			                        & "<div class='tt-team' style='color:" & [@Color] & "'>" & [@TeamName] & "</div>"
			                    & "</div>"
			                & "</div>"
			                & "<div class='tt-grid'>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & 'Standings Snapshot'[Wins] & "</div><div class='tt-l'>Wins</div></div>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & [@Podiums] & "</div><div class='tt-l'>Podiums</div></div>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & [@FLs] & "</div><div class='tt-l'>Fastest Laps</div></div>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & FORMAT ( [@AvgFinish], "0.0" ) & "</div><div class='tt-l'>Avg Finish</div></div>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & FORMAT ( [@AvgGrid], "0.0" ) & "</div><div class='tt-l'>Avg Grid</div></div>"
			                    & "<div class='tt-stat'><div class='tt-v'>" & [@DNFs] & "</div><div class='tt-l'>DNFs</div></div>"
			                & "</div>"
			                & "<div class='tt-foot'>" & UPPER ( IF ( ISBLANK ( [@Nat] ), "—", [@Nat] ) ) & " · " & FORMAT ( 'Standings Snapshot'[Points], "0" ) & " PTS</div>"
			            & "</div>"
			        & "</div>",
			        "",
			        'Standings Snapshot'[Position], ASC
			    )
			
			// ---------- CONSTRUCTORS ----------
			VAR ConstructorTotals =
			    ADDCOLUMNS (
			        VALUES ( Constructors[ConstructorId] ),
			        "@CName", CALCULATE ( MAX ( Constructors[ConstructorName] ) ),
			        "@CColor", CALCULATE ( MAX ( Constructors[TeamColor] ) ),
			        "@CPoints",
			            CALCULATE (
			                SUM ( Results[Points] ),
			                ALLEXCEPT ( Constructors, Constructors[ConstructorId] )
			            )
			    )
			VAR ConstructorFiltered =
			    FILTER ( ConstructorTotals, NOT ISBLANK ( [@CPoints] ) && [@CPoints] > 0 )
			VAR MaxConstructorPoints = MAXX ( ConstructorFiltered, [@CPoints] )
			VAR ConstructorRowsHTML =
			    CONCATENATEX (
			        ConstructorFiltered,
			        VAR BarPct = DIVIDE ( [@CPoints], MaxConstructorPoints ) * 100
			        VAR Idx = RANKX ( ConstructorFiltered, [@CPoints], , DESC )
			        VAR DelayMs = Idx * 80
			        RETURN
			            "<div class='crow' style='animation-delay:" & DelayMs & "ms'>"
			                & "<div class='cname'>" & [@CName] & "</div>"
			                & "<div class='cbar-wrap'>"
			                    & "<div class='cbar' style='width:" & FORMAT ( BarPct, "0.0" )
			                        & "%;background:" & [@CColor]
			                        & ";animation-delay:" & ( DelayMs + 200 ) & "ms;'></div>"
			                & "</div>"
			                & "<div class='cpts'>" & FORMAT ( [@CPoints], "0" ) & "</div>"
			            & "</div>",
			        "",
			        [@CPoints], DESC
			    )
			
			// ---------- CALENDAR MAP ----------
			// Map dimensions and projection
			VAR MapW = 460
			VAR MapH = 230
			VAR MapPad = 10
			// Equirectangular projection: lat/long → x/y
			// x = (lng + 180) / 360 * (MapW - 2*MapPad) + MapPad
			// y = (90 - lat) / 180 * (MapH - 2*MapPad) + MapPad
			
			VAR AllRaces =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Races,
			            Races[Round],
			            Races[RaceName],
			            Races[Country],
			            Races[Date],
			            Races[Lat],
			            Races[Long]
			        ),
			        ALL ( Races )
			    )
			VAR RacesEnriched =
			    ADDCOLUMNS (
			        AllRaces,
			        "@Status",
			            SWITCH (
			                TRUE (),
			                Races[Round] = LatestRound, "current",
			                Races[Round] < LatestRound, "done",
			                "upcoming"
			            ),
			        "@CX",
			            ( Races[Long] + 180 ) / 360 * ( MapW - 2 * MapPad ) + MapPad,
			        "@CY",
			            ( 90 - Races[Lat] ) / 180 * ( MapH - 2 * MapPad ) + MapPad
			    )
			
			VAR CompletedCount =
			    COUNTROWS ( FILTER ( RacesEnriched, [@Status] = "done" ) )
			VAR UpcomingCount =
			    COUNTROWS ( FILTER ( RacesEnriched, [@Status] = "upcoming" ) )
			
			VAR CircuitPinsSvg =
			    CONCATENATEX (
			        RacesEnriched,
			        VAR State = [@Status]
			        VAR PinClass = "pin pin-" & State
			        VAR Cx = FORMAT ( [@CX], "0.00" )
			        VAR Cy = FORMAT ( [@CY], "0.00" )
			        VAR Radius = IF ( State = "current", "5", "3.5" )
			        RETURN
			            "<g class='" & PinClass & "'>"
			                & "<circle cx='" & Cx & "' cy='" & Cy & "' r='" & Radius & "' />"
			                & IF ( State = "current",
			                    "<circle class='pulse-ring' cx='" & Cx & "' cy='" & Cy & "' r='5' />",
			                    ""
			                )
			            & "</g>",
			        ""
			    )
			
			// World map continents (simplified silhouettes, ~equirectangular projection-friendly)
			VAR WorldMapPaths =
			    "<path d='M155,55 Q145,50 138,60 L130,72 Q125,80 130,88 L138,95 L150,92 L165,90 L172,80 Q175,68 170,60 Z' />"     // North America
			    & "<path d='M178,100 L185,115 L188,135 L182,150 L172,158 L168,148 L170,135 L175,120 Z' />"                          // South America
			    & "<path d='M218,55 L228,50 L240,55 L248,62 L255,70 L250,80 L240,85 L228,80 L220,75 Z' />"                          // Europe
			    & "<path d='M225,85 L240,90 L260,95 L275,105 L285,120 L280,140 L268,150 L255,148 L240,138 L228,120 L222,105 Z' />"  // Africa
			    & "<path d='M260,60 L280,55 L305,58 L325,65 L345,72 L355,82 L350,95 L335,100 L315,98 L290,92 L270,85 Z' />"        // Asia
			    & "<path d='M340,140 L355,138 L370,145 L375,158 L365,165 L350,162 L342,152 Z' />"                                  // Australia
			
			VAR CalendarMapSvg =
			    "<svg viewBox='0 0 " & MapW & " " & MapH & "' xmlns='http://www.w3.org/2000/svg' class='cal-map'>"
			        & "<g class='continents'>" & WorldMapPaths & "</g>"
			        & CircuitPinsSvg
			    & "</svg>"
			
			// ---------- RECENT RACES ----------
			VAR RecentRaces =
			    FILTER (
			        ALL ( Races[Round], Races[RaceName], Races[Country], Races[Date] ),
			        Races[Round] >= LatestRound - 2 && Races[Round] <= LatestRound
			    )
			VAR RecentRowsHTML =
			    CONCATENATEX (
			        RecentRaces,
			        VAR R = Races[Round]
			        VAR P1 = CALCULATE ( MAX ( Results[DriverName] ), Results[Round] = R, Results[Position] = 1 )
			        VAR P1ConId = CALCULATE ( MAX ( Results[ConstructorId] ), Results[Round] = R, Results[Position] = 1 )
			        VAR P1Team = LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], P1ConId )
			        VAR P2 = CALCULATE ( MAX ( Results[DriverName] ), Results[Round] = R, Results[Position] = 2 )
			        VAR P3 = CALCULATE ( MAX ( Results[DriverName] ), Results[Round] = R, Results[Position] = 3 )
			        VAR Idx = LatestRound - R
			        VAR DelayMs = Idx * 120
			        RETURN
			            IF ( NOT ISBLANK ( P1 ),
			                "<div class='race' style='animation-delay:" & DelayMs & "ms'>"
			                    & "<div class='rhead'>"
			                        & "<span class='rrn'>R" & R & "</span>"
			                        & "<span class='rname'>" & Races[Country] & "</span>"
			                    & "</div>"
			                    & "<div class='podium-mini'>"
			                        & "<div class='pp pp1' style='border-left:3px solid " & IF ( ISBLANK ( P1Team ), "#888", P1Team ) & "'>"
			                            & "<span class='pn pn1'>1</span>"
			                            & "<span class='pname'>" & P1 & "</span>"
			                        & "</div>"
			                        & "<div class='pp pp2'><span class='pn pn2'>2</span><span class='pname'>" & IF ( ISBLANK ( P2 ), "—", P2 ) & "</span></div>"
			                        & "<div class='pp pp3'><span class='pn pn3'>3</span><span class='pname'>" & IF ( ISBLANK ( P3 ), "—", P3 ) & "</span></div>"
			                    & "</div>"
			                & "</div>",
			                ""
			            ),
			        "",
			        Races[Round], DESC
			    )
			
			// ---------- ASSEMBLE ----------
			RETURN
			"<style>"
			& ".dash *{box-sizing:border-box;margin:0;padding:0;font-family:'Inter','Segoe UI',-apple-system,sans-serif;-webkit-font-smoothing:antialiased}"
			& ".dash{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:auto auto auto auto auto;grid-gap:14px;padding:18px;background:#0a0a0d;min-height:100vh;color:#ffffff;position:relative;overflow:hidden}"
			
			// ANIMATIONS
			& "@keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}"
			& "@keyframes fadeInLeft{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:translateX(0)}}"
			& "@keyframes f1pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.85)}}"
			& "@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}"
			& "@keyframes glowPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,24,1,0.4)}50%{box-shadow:0 0 0 8px rgba(255,24,1,0)}}"
			& "@keyframes pinPulse{0%{r:5;opacity:0.8}100%{r:14;opacity:0}}"
			& "@keyframes pinDrop{from{opacity:0;transform:translateY(-8px) scale(0.5)}to{opacity:1;transform:translateY(0) scale(1)}}"
			
			// HEADER
			& ".dash .header{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:6px 4px 14px;border-bottom:1px solid #2a2a30;animation:fadeInUp 0.6s cubic-bezier(0.16,1,0.3,1) backwards}"
			& ".dash .title{display:flex;align-items:center;gap:14px;color:#ffffff}"
			& ".dash .title .bar{width:5px;height:32px;background:#FF1801;border-radius:2px;display:inline-block}"
			& ".dash .title h1{font-size:22px;font-weight:800;letter-spacing:0.05em;color:#ffffff;margin:0}"
			& ".dash .title h1 .red{color:#FF1801}"
			& ".dash .roundbox{text-align:right;font-size:11px;color:#aaaaaa;letter-spacing:0.1em;text-transform:uppercase}"
			& ".dash .roundbox .big{font-size:18px;color:#ffffff;font-weight:700;letter-spacing:0.02em;margin-top:2px}"
			& ".dash .live-dot{display:inline-block;width:6px;height:6px;background:#FF1801;border-radius:50%;margin-right:6px;animation:glowPulse 2s infinite}"
			
			// KPI
			& ".dash .kpi{background:linear-gradient(135deg,#1a1a1f,#15151a);border:1px solid #2a2a30;border-radius:8px;padding:16px 18px;position:relative;overflow:hidden;color:#ffffff;animation:fadeInUp 0.6s cubic-bezier(0.16,1,0.3,1) backwards;transition:transform 0.2s,border-color 0.2s}"
			& ".dash .kpi:hover{transform:translateY(-2px);border-color:#3a3a45}"
			& ".dash .kpi.k1{animation-delay:0.05s}.dash .kpi.k2{animation-delay:0.1s}.dash .kpi.k3{animation-delay:0.15s}.dash .kpi.k4{animation-delay:0.2s}"
			& ".dash .kpi .accent-bar{position:absolute;left:0;top:0;width:4px;height:100%}"
			& ".dash .kpi.k1 .accent-bar{background:#FF1801}.dash .kpi.k2 .accent-bar{background:#FFCC00}.dash .kpi.k3 .accent-bar{background:#27F4D2}.dash .kpi.k4 .accent-bar{background:#3671C6}"
			& ".dash .kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);animation:shimmer 3s infinite;animation-delay:1s}"
			& ".dash .kpi .label{font-size:10px;color:#aaaaaa;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:8px;font-weight:600}"
			& ".dash .kpi .value{font-size:24px;font-weight:800;letter-spacing:-0.02em;line-height:1.1;color:#ffffff}"
			& ".dash .kpi .sub{font-size:11px;color:#aaaaaa;margin-top:6px}"
			
			// PANELS
			& ".dash .panel{background:#15151a;border:1px solid #2a2a30;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;color:#ffffff;animation:fadeInUp 0.7s cubic-bezier(0.16,1,0.3,1) backwards}"
			& ".dash .panel.p1{animation-delay:0.25s}.dash .panel.p2{animation-delay:0.3s}.dash .panel.p3{animation-delay:0.35s}.dash .panel.p4{animation-delay:0.4s}"
			& ".dash .panel-head{padding:12px 16px;border-bottom:1px solid #2a2a30;display:flex;justify-content:space-between;align-items:center;background:#1a1a1f}"
			& ".dash .panel-head h2{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#cccccc;font-weight:700;margin:0;display:flex;align-items:center}"
			& ".dash .panel-head .accent-dot{width:8px;height:8px;background:#FF1801;border-radius:50%;display:inline-block;margin-right:8px;animation:f1pulse 2s infinite}"
			& ".dash .panel-head .meta{font-size:10px;color:#888888}"
			& ".dash .panel-body{padding:0;overflow-y:auto;color:#ffffff;position:relative}"
			
			// STANDINGS
			& ".dash .standings{display:flex;flex-direction:column}"
			& ".dash .row{display:grid;grid-template-columns:36px 50px 1fr 50px 70px 70px;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #1f1f24;transition:background 0.2s,transform 0.2s;color:#ffffff;position:relative;cursor:default;animation:fadeInLeft 0.4s ease-out backwards}"
			& ".dash .row:hover{background:#1f1f24;transform:translateX(2px)}"
			& ".dash .row .pos{font-weight:800;font-size:18px;color:#ffffff;text-align:center;font-variant-numeric:tabular-nums}"
			& ".dash .row .code{font-family:'JetBrains Mono','Consolas',monospace;font-size:11px;color:#cccccc;letter-spacing:0.05em;background:#0a0a0d;padding:3px 6px;border-radius:3px;text-align:center}"
			& ".dash .row .dname{display:flex;flex-direction:column;gap:2px}"
			& ".dash .row .dname .dname-main{font-size:14px;font-weight:600;color:#ffffff}"
			& ".dash .row .dname .dname-sub{font-size:10px;color:#aaaaaa;font-weight:500;letter-spacing:0.03em}"
			& ".dash .row .wins{font-size:11px;color:#FFCC00;font-weight:700;text-align:right}"
			& ".dash .row .pts{font-size:16px;font-weight:800;color:#ffffff;text-align:right;font-variant-numeric:tabular-nums}"
			& ".dash .row .gap{font-size:11px;color:#aaaaaa;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:0.03em}"
			
			// TOOLTIPS
			& ".dash .tooltip{position:absolute;left:50%;top:100%;transform:translateX(-50%) translateY(-6px);width:320px;background:#1a1a1f;border:1px solid #2a2a30;border-radius:6px;padding:0;box-shadow:0 12px 32px rgba(0,0,0,0.6);opacity:0;pointer-events:none;transition:opacity 0.2s,transform 0.2s;z-index:1000;overflow:hidden}"
			& ".dash .row:hover .tooltip{opacity:1;transform:translateX(-50%) translateY(2px);pointer-events:auto}"
			& ".dash .tt-head{display:flex;gap:12px;align-items:center;padding:14px 14px 10px;background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent)}"
			& ".dash .tt-num{width:42px;height:42px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;color:#ffffff;font-family:'JetBrains Mono',monospace;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,0.3)}"
			& ".dash .tt-id{flex:1;min-width:0}"
			& ".dash .tt-name{font-size:15px;font-weight:700;color:#ffffff;line-height:1.2}"
			& ".dash .tt-team{font-size:11px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-top:3px}"
			& ".dash .tt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#2a2a30;margin:0 14px;border-radius:4px;overflow:hidden}"
			& ".dash .tt-stat{padding:10px 8px;background:#15151a;text-align:center}"
			& ".dash .tt-v{font-size:18px;font-weight:800;color:#ffffff;line-height:1;font-variant-numeric:tabular-nums}"
			& ".dash .tt-l{font-size:9px;color:#888888;text-transform:uppercase;letter-spacing:0.08em;margin-top:5px;font-weight:600}"
			& ".dash .tt-foot{padding:10px 14px;font-size:10px;color:#888888;letter-spacing:0.08em;border-top:1px solid #2a2a30;background:#0f0f12;text-align:center;font-weight:600}"
			
			// CONSTRUCTORS
			& ".dash .constructors{padding:14px 16px;display:flex;flex-direction:column;gap:10px}"
			& ".dash .crow{display:grid;grid-template-columns:120px 1fr 70px;align-items:center;gap:12px;animation:fadeInLeft 0.5s ease-out backwards}"
			& ".dash .crow .cname{font-size:12px;font-weight:600;color:#ffffff}"
			& ".dash .crow .cbar-wrap{height:22px;background:#0a0a0d;border-radius:3px;overflow:hidden;position:relative}"
			& ".dash .crow .cbar{height:100%;border-radius:3px;position:relative;overflow:hidden}"
			& ".dash .crow .cpts{font-size:14px;font-weight:800;text-align:right;color:#ffffff;font-variant-numeric:tabular-nums}"
			
			// CALENDAR MAP
			& ".dash .map-body{padding:16px;display:flex;flex-direction:column;gap:12px}"
			& ".dash .cal-map{width:100%;height:auto;display:block;background:#0a0a0d;border-radius:4px}"
			& ".dash .cal-map .continents path{fill:#1f1f24;stroke:#2a2a30;stroke-width:0.5}"
			& ".dash .cal-map .pin{animation:pinDrop 0.5s ease-out backwards;animation-delay:0.5s;cursor:pointer;transition:transform 0.2s;transform-origin:center;transform-box:fill-box}"
			& ".dash .cal-map .pin:hover{transform:scale(1.6)}"
			& ".dash .cal-map .pin-done circle{fill:#22C55E;stroke:#0a0a0d;stroke-width:1}"
			& ".dash .cal-map .pin-upcoming circle{fill:#666666;stroke:#0a0a0d;stroke-width:1;opacity:0.7}"
			& ".dash .cal-map .pin-current circle{fill:#FF1801;stroke:#ffffff;stroke-width:1.5}"
			& ".dash .cal-map .pulse-ring{fill:none;stroke:#FF1801;stroke-width:2;animation:pinPulse 1.8s infinite}"
			& ".dash .map-legend{display:flex;justify-content:center;gap:18px;font-size:10px;color:#aaaaaa;letter-spacing:0.05em;text-transform:uppercase}"
			& ".dash .legend-item{display:flex;align-items:center;gap:6px}"
			& ".dash .legend-dot{width:8px;height:8px;border-radius:50%;display:inline-block}"
			& ".dash .ld-done{background:#22C55E}"
			& ".dash .ld-current{background:#FF1801}"
			& ".dash .ld-upcoming{background:#666666}"
			
			// RECENT
			& ".dash .recent{padding:14px 16px;display:flex;flex-direction:column;gap:14px}"
			& ".dash .race{padding:12px 14px;background:#0f0f12;border-left:3px solid #FF1801;border-radius:3px;color:#ffffff;animation:fadeInUp 0.5s ease-out backwards;transition:transform 0.2s}"
			& ".dash .race:hover{transform:translateX(3px)}"
			& ".dash .rhead{margin-bottom:8px;display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:0.05em;text-transform:uppercase}"
			& ".dash .rrn{color:#FF1801;font-weight:800}"
			& ".dash .rname{color:#ffffff;font-weight:600}"
			& ".dash .podium-mini{display:flex;flex-direction:column;gap:5px}"
			& ".dash .pp{display:flex;align-items:center;gap:10px;font-size:12px;padding:6px 10px;border-radius:3px;background:#15151a;color:#ffffff;transition:transform 0.15s}"
			& ".dash .pp:hover{transform:translateX(2px)}"
			& ".dash .pp1{background:linear-gradient(90deg,rgba(255,204,0,0.18),rgba(255,204,0,0.04))}"
			& ".dash .pp2{background:rgba(255,255,255,0.04)}"
			& ".dash .pp3{background:rgba(205,127,50,0.08)}"
			& ".dash .pname{color:#ffffff;font-weight:500}"
			& ".dash .pn{font-weight:800;font-size:11px;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;flex-shrink:0}"
			& ".dash .pn1{background:#FFCC00;color:#000000}.dash .pn2{background:#C0C0C0;color:#000000}.dash .pn3{background:#CD7F32;color:#ffffff}"
			
			& ".dash .empty{padding:40px;text-align:center;color:#888888;font-size:13px}"
			& "</style>"
			
			& "<div class='dash'>"
			
			// HEADER (row 1)
			& "<div class='header'>"
			    & "<div class='title'>"
			        & "<span class='bar'></span>"
			        & "<h1>FORMULA <span class='red'>1</span> &nbsp;·&nbsp; 2026 SEASON</h1>"
			    & "</div>"
			    & "<div class='roundbox'>"
			        & "<span class='live-dot'></span>Latest Round"
			        & "<div class='big'>R" & LatestRound & " / " & TotalRounds & " · " & UPPER ( IF ( ISBLANK ( LatestCountry ), "—", LatestCountry ) ) & "</div>"
			    & "</div>"
			& "</div>"
			
			// KPIs (row 2)
			& "<div class='kpi k1' style='grid-column:1/4;grid-row:2'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Championship Leader</div>"
			    & "<div class='value'>" & IF ( ISBLANK ( LeaderName ), "—", LeaderName ) & "</div>"
			    & "<div class='sub'>" & FORMAT ( LeaderPoints, "0" ) & " points</div>"
			& "</div>"
			& "<div class='kpi k2' style='grid-column:4/7;grid-row:2'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Lead over P2</div>"
			    & "<div class='value'>+" & FORMAT ( P1P2Gap, "0" ) & "</div>"
			    & "<div class='sub'>points</div>"
			& "</div>"
			& "<div class='kpi k3' style='grid-column:7/10;grid-row:2'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Races Remaining</div>"
			    & "<div class='value'>" & RacesRem & "</div>"
			    & "<div class='sub'>of " & TotalRounds & " round season</div>"
			& "</div>"
			& "<div class='kpi k4' style='grid-column:10/13;grid-row:2'>"
			    & "<span class='accent-bar'></span>"
			    & "<div class='label'>Last Race</div>"
			    & "<div class='value' style='font-size:18px'>" & IF ( ISBLANK ( LatestRaceName ), "Season not started", LatestRaceName ) & "</div>"
			    & "<div class='sub'>" & UPPER ( IF ( ISBLANK ( LatestCountry ), "—", LatestCountry ) ) & "</div>"
			& "</div>"
			
			// DRIVER STANDINGS (rows 3-5, left)
			& "<div class='panel p1' style='grid-column:1/8;grid-row:3/6'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Driver Standings</h2><span class='meta'>HOVER FOR DETAILS</span></div>"
			    & "<div class='panel-body standings'>"
			        & IF ( ISBLANK ( DriverRowsHTML ),
			            "<div class='empty'>No race data yet for the 2026 season.</div>",
			            DriverRowsHTML )
			    & "</div>"
			& "</div>"
			
			// CONSTRUCTORS (row 3, right)
			& "<div class='panel p2' style='grid-column:8/13;grid-row:3'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Constructors Championship</h2></div>"
			    & "<div class='panel-body constructors'>"
			        & IF ( ISBLANK ( ConstructorRowsHTML ),
			            "<div class='empty'>Awaiting first race.</div>",
			            ConstructorRowsHTML )
			    & "</div>"
			& "</div>"
			
			// CALENDAR MAP (row 4, right)
			& "<div class='panel p3' style='grid-column:8/13;grid-row:4'>"
			    & "<div class='panel-head'>"
			        & "<h2><span class='accent-dot'></span>Season Calendar</h2>"
			        & "<span class='meta'>" & CompletedCount & " DONE · " & UpcomingCount & " UPCOMING</span>"
			    & "</div>"
			    & "<div class='map-body'>"
			        & CalendarMapSvg
			        & "<div class='map-legend'>"
			            & "<div class='legend-item'><span class='legend-dot ld-done'></span>Completed</div>"
			            & "<div class='legend-item'><span class='legend-dot ld-current'></span>Latest</div>"
			            & "<div class='legend-item'><span class='legend-dot ld-upcoming'></span>Upcoming</div>"
			        & "</div>"
			    & "</div>"
			& "</div>"
			
			// RECENT (row 5, right)
			& "<div class='panel p4' style='grid-column:8/13;grid-row:5'>"
			    & "<div class='panel-head'><h2><span class='accent-dot'></span>Recent Race Winners</h2></div>"
			    & "<div class='panel-body recent'>"
			        & IF ( ISBLANK ( RecentRowsHTML ),
			            "<div class='empty'>Awaiting first race.</div>",
			            RecentRowsHTML )
			    & "</div>"
			& "</div>"
			
			& "</div>"
		lineageTag: 6b5124b2-e810-414d-8cf9-6724464b6d21

	measure 'Race Results HTML' =
			
			
			// ---------- SELECTED RACE ----------
			VAR SelRound =
			    SELECTEDVALUE ( Races[Round] )
			VAR SelRaceName =
			    SELECTEDVALUE ( Races[RaceName] )
			VAR SelCircuit =
			    SELECTEDVALUE ( Races[CircuitName] )
			VAR SelCountry =
			    SELECTEDVALUE ( Races[Country] )
			VAR SelCity =
			    SELECTEDVALUE ( Races[City] )
			VAR SelDate =
			    SELECTEDVALUE ( Races[Date] )
			
			// Fallback to latest round if no slicer selection
			VAR EffectiveRound =
			    IF (
			        ISBLANK ( SelRound ),
			        CALCULATE ( MAX ( Results[Round] ), ALL ( Races ) ),
			        SelRound
			    )
			VAR EffectiveRaceName =
			    IF ( ISBLANK ( SelRaceName ),
			        CALCULATE ( MAX ( Races[RaceName] ), Races[Round] = EffectiveRound, ALL ( Races ) ),
			        SelRaceName
			    )
			VAR EffectiveCircuit =
			    IF ( ISBLANK ( SelCircuit ),
			        CALCULATE ( MAX ( Races[CircuitName] ), Races[Round] = EffectiveRound, ALL ( Races ) ),
			        SelCircuit
			    )
			VAR EffectiveCountry =
			    IF ( ISBLANK ( SelCountry ),
			        CALCULATE ( MAX ( Races[Country] ), Races[Round] = EffectiveRound, ALL ( Races ) ),
			        SelCountry
			    )
			VAR EffectiveCity =
			    IF ( ISBLANK ( SelCity ),
			        CALCULATE ( MAX ( Races[City] ), Races[Round] = EffectiveRound, ALL ( Races ) ),
			        SelCity
			    )
			VAR EffectiveDate =
			    IF ( ISBLANK ( SelDate ),
			        CALCULATE ( MAX ( Races[Date] ), Races[Round] = EffectiveRound, ALL ( Races ) ),
			        SelDate
			    )
			
			// ---------- RACE-LEVEL STATS ----------
			VAR DriversFinished =
			    CALCULATE (
			        COUNTROWS ( Results ),
			        Results[Round] = EffectiveRound,
			        Results[Status] = "Finished",
			        ALL ( Races )
			    )
			VAR DriversDNF =
			    CALCULATE (
			        COUNTROWS ( Results ),
			        Results[Round] = EffectiveRound,
			        NOT ( Results[Status] = "Finished" ),
			        NOT ( CONTAINSSTRING ( Results[Status], "Lap" ) ),
			        ALL ( Races )
			    )
			VAR TotalLaps =
			    CALCULATE (
			        MAX ( Results[Laps] ),
			        Results[Round] = EffectiveRound,
			        Results[Position] = 1,
			        ALL ( Races )
			    )
			
			// FASTEST LAP
			VAR FLDriver =
			    CALCULATE (
			        MAX ( Results[DriverName] ),
			        Results[Round] = EffectiveRound,
			        Results[FLRank] = "1",
			        ALL ( Races )
			    )
			VAR FLTime =
			    CALCULATE (
			        MAX ( Results[FLTime] ),
			        Results[Round] = EffectiveRound,
			        Results[FLRank] = "1",
			        ALL ( Races )
			    )
			VAR FLLap =
			    CALCULATE (
			        MAX ( Results[FLLap] ),
			        Results[Round] = EffectiveRound,
			        Results[FLRank] = "1",
			        ALL ( Races )
			    )
			VAR FLTeamColor =
			    CALCULATE (
			        MAX ( Constructors[TeamColor] ),
			        Results[Round] = EffectiveRound,
			        Results[FLRank] = "1",
			        ALL ( Races )
			    )
			
			// POLE POSITION
			VAR PoleDriver =
			    CALCULATE (
			        MAX ( Results[DriverName] ),
			        Results[Round] = EffectiveRound,
			        Results[Grid] = 1,
			        ALL ( Races )
			    )
			
			// ---------- PODIUM ----------
			VAR PodiumP1 =
			    CALCULATETABLE (
			        ROW (
			            "name", MAX ( Results[DriverName] ),
			            "constructorId", MAX ( Results[ConstructorId] ),
			            "code", MAX ( Drivers[DriverCode] ),
			            "number", MAX ( Drivers[DriverNumber] ),
			            "time", MAX ( Results[RaceTime] )
			        ),
			        Results[Round] = EffectiveRound,
			        Results[Position] = 1,
			        ALL ( Races )
			    )
			VAR PodiumP2 =
			    CALCULATETABLE (
			        ROW (
			            "name", MAX ( Results[DriverName] ),
			            "constructorId", MAX ( Results[ConstructorId] ),
			            "code", MAX ( Drivers[DriverCode] ),
			            "number", MAX ( Drivers[DriverNumber] ),
			            "time", MAX ( Results[RaceTime] )
			        ),
			        Results[Round] = EffectiveRound,
			        Results[Position] = 2,
			        ALL ( Races )
			    )
			VAR PodiumP3 =
			    CALCULATETABLE (
			        ROW (
			            "name", MAX ( Results[DriverName] ),
			            "constructorId", MAX ( Results[ConstructorId] ),
			            "code", MAX ( Drivers[DriverCode] ),
			            "number", MAX ( Drivers[DriverNumber] ),
			            "time", MAX ( Results[RaceTime] )
			        ),
			        Results[Round] = EffectiveRound,
			        Results[Position] = 3,
			        ALL ( Races )
			    )
			VAR P1Name = MAXX ( PodiumP1, [name] )
			VAR P1ConId = MAXX ( PodiumP1, [constructorId] )
			VAR P1Team = LOOKUPVALUE ( Constructors[ConstructorName], Constructors[ConstructorId], P1ConId )
			VAR P1Color = LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], P1ConId )
			VAR P1Code = MAXX ( PodiumP1, [code] )
			VAR P1Number = MAXX ( PodiumP1, [number] )
			VAR P1Time = MAXX ( PodiumP1, [time] )
			
			VAR P2Name = MAXX ( PodiumP2, [name] )
			VAR P2ConId = MAXX ( PodiumP2, [constructorId] )
			VAR P2Team = LOOKUPVALUE ( Constructors[ConstructorName], Constructors[ConstructorId], P2ConId )
			VAR P2Color = LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], P2ConId )
			VAR P2Code = MAXX ( PodiumP2, [code] )
			VAR P2Number = MAXX ( PodiumP2, [number] )
			VAR P2Time = MAXX ( PodiumP2, [time] )
			
			VAR P3Name = MAXX ( PodiumP3, [name] )
			VAR P3ConId = MAXX ( PodiumP3, [constructorId] )
			VAR P3Team = LOOKUPVALUE ( Constructors[ConstructorName], Constructors[ConstructorId], P3ConId )
			VAR P3Color = LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], P3ConId )
			VAR P3Code = MAXX ( PodiumP3, [code] )
			VAR P3Number = MAXX ( PodiumP3, [number] )
			VAR P3Time = MAXX ( PodiumP3, [time] )
			
			// ---------- FULL RESULTS TABLE ----------
			VAR ResultsRows =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Results,
			            Results[DriverId],
			            Results[ConstructorId],
			            Results[Position],
			            Results[PositionText],
			            Results[Points],
			            Results[Grid],
			            Results[Laps],
			            Results[Status],
			            Results[FLRank]
			        ),
			        Results[Round] = EffectiveRound,
			        ALL ( Races )
			    )
			VAR ResultsEnriched =
			    ADDCOLUMNS (
			        ResultsRows,
			        "@Name",
			            LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], Results[DriverId] ),
			        "@Code",
			            LOOKUPVALUE ( Drivers[DriverCode], Drivers[DriverId], Results[DriverId] ),
			        "@TeamName",
			            LOOKUPVALUE ( Constructors[ConstructorName], Constructors[ConstructorId], Results[ConstructorId] ),
			        "@Color",
			            LOOKUPVALUE ( Constructors[TeamColor], Constructors[ConstructorId], Results[ConstructorId] ),
			        "@SortKey",
			            IF ( ISBLANK ( Results[Position] ), 99 + RAND (), Results[Position] * 1.0 ),
			        "@PosDelta",
			            IF ( NOT ISBLANK ( Results[Position] ), Results[Grid] - Results[Position], BLANK () )
			    )
			VAR ResultsRowsHTML =
			    CONCATENATEX (
			        ResultsEnriched,
			        VAR DispPos = IF ( ISBLANK ( Results[Position] ), Results[PositionText], Results[Position] & "" )
			        VAR PosDelta = [@PosDelta]
			        VAR DeltaHTML =
			            IF ( ISBLANK ( PosDelta ), "<span class='delta-none'>—</span>",
			                IF ( PosDelta > 0,
			                    "<span class='delta-up'>&#9650; " & PosDelta & "</span>",
			                    IF ( PosDelta < 0,
			                        "<span class='delta-down'>&#9660; " & ABS ( PosDelta ) & "</span>",
			                        "<span class='delta-flat'>—</span>" ) ) )
			        VAR FLBadge = IF ( Results[FLRank] = "1", "<span class='fl-badge'>FL</span>", "" )
			        VAR DNFClass = IF ( ISBLANK ( Results[Position] ), " dnf", "" )
			        VAR DelayMs = INT ( [@SortKey] ) * 30
			        RETURN
			            "<div class='rrow" & DNFClass & "' style='border-left:3px solid " & [@Color] & ";animation-delay:" & DelayMs & "ms'>"
			                & "<div class='rpos'>" & DispPos & "</div>"
			                & "<div class='rcode'>" & IF ( ISBLANK ( [@Code] ), "—", [@Code] ) & "</div>"
			                & "<div class='rname'>"
			                    & "<div class='rname-main'>" & [@Name] & FLBadge & "</div>"
			                    & "<div class='rname-sub'>" & [@TeamName] & "</div>"
			                & "</div>"
			                & "<div class='rgrid'>P" & Results[Grid] & "</div>"
			                & "<div class='rdelta'>" & DeltaHTML & "</div>"
			                & "<div class='rlaps'>" & Results[Laps] & "</div>"
			                & "<div class='rpts'>" & FORMAT ( Results[Points], "0" ) & "</div>"
			                & "<div class='rstat'>" & Results[Status] & "</div>"
			            & "</div>",
			        "",
			        [@SortKey], ASC
			    )
			
			// ---------- ASSEMBLE HTML ----------
			RETURN
			"<style>"
			& ".rdash *{box-sizing:border-box;margin:0;padding:0;font-family:'Inter','Segoe UI',-apple-system,sans-serif;-webkit-font-smoothing:antialiased}"
			& ".rdash{display:grid;grid-template-columns:repeat(12,1fr);grid-gap:14px;padding:18px;background:#0a0a0d;min-height:100vh;color:#ffffff}"
			
			// ANIMATIONS
			& "@keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}"
			& "@keyframes fadeInLeft{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:translateX(0)}}"
			& "@keyframes podiumRise{from{opacity:0;transform:translateY(40px) scale(0.95)}to{opacity:1;transform:translateY(0) scale(1)}}"
			& "@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}"
			& "@keyframes f1pulse{0%,100%{opacity:1}50%{opacity:0.4}}"
			
			// HEADER
			& ".rdash .rhead{grid-column:1/-1;display:flex;justify-content:space-between;align-items:flex-end;padding:6px 4px 16px;border-bottom:1px solid #2a2a30;animation:fadeInUp 0.5s cubic-bezier(0.16,1,0.3,1) backwards}"
			& ".rdash .rh-left{display:flex;align-items:center;gap:14px}"
			& ".rdash .rh-bar{width:5px;height:48px;background:#FF1801;border-radius:2px}"
			& ".rdash .rh-titles .rh-rname{font-size:24px;font-weight:800;letter-spacing:-0.01em;color:#ffffff;line-height:1.1}"
			& ".rdash .rh-titles .rh-meta{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#aaaaaa;margin-top:6px;font-weight:600}"
			& ".rdash .rh-right{text-align:right;display:flex;gap:24px;align-items:center}"
			& ".rdash .rh-stat{text-align:center}"
			& ".rdash .rh-stat .v{font-size:24px;font-weight:800;color:#ffffff;line-height:1}"
			& ".rdash .rh-stat .l{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:#888888;margin-top:5px;font-weight:600}"
			
			// PODIUM
			& ".rdash .podium-panel{grid-column:1/8;grid-row:2;background:linear-gradient(135deg,#15151a,#1a1a1f);border:1px solid #2a2a30;border-radius:8px;padding:24px;position:relative;overflow:hidden;animation:fadeInUp 0.6s cubic-bezier(0.16,1,0.3,1) backwards;animation-delay:0.1s}"
			& ".rdash .podium-panel::before{content:'PODIUM';position:absolute;top:14px;left:18px;font-size:10px;letter-spacing:0.15em;color:#888888;font-weight:700}"
			& ".rdash .podium{display:flex;align-items:flex-end;justify-content:center;gap:14px;height:280px;margin-top:20px}"
			& ".rdash .pblock{display:flex;flex-direction:column;align-items:center;animation:podiumRise 0.7s cubic-bezier(0.16,1,0.3,1) backwards}"
			& ".rdash .pblock.b1{animation-delay:0.5s}"
			& ".rdash .pblock.b2{animation-delay:0.3s}"
			& ".rdash .pblock.b3{animation-delay:0.4s}"
			& ".rdash .pcard{text-align:center;margin-bottom:8px;min-width:140px}"
			& ".rdash .pcard .pnum{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:900;color:#ffffff;display:inline-block;padding:4px 10px;border-radius:4px;margin-bottom:6px}"
			& ".rdash .pcard .pn{font-size:14px;font-weight:700;color:#ffffff;line-height:1.2}"
			& ".rdash .pcard .pt{font-size:10px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-top:2px}"
			& ".rdash .pcard .ptm{font-size:9px;color:#aaaaaa;margin-top:4px;font-family:'JetBrains Mono',monospace}"
			& ".rdash .pstand{width:120px;color:#ffffff;font-size:48px;font-weight:900;display:flex;align-items:center;justify-content:center;border-radius:6px 6px 0 0;position:relative;overflow:hidden}"
			& ".rdash .pstand::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.4),transparent);animation:shimmer 3s infinite;animation-delay:1.5s}"
			& ".rdash .pstand.s1{height:200px;background:linear-gradient(180deg,#FFCC00,#E6B800)}"
			& ".rdash .pstand.s2{height:150px;background:linear-gradient(180deg,#C0C0C0,#A8A8A8)}"
			& ".rdash .pstand.s3{height:100px;background:linear-gradient(180deg,#CD7F32,#A0612A)}"
			
			// FACT CARDS
			& ".rdash .facts-col{grid-column:8/13;grid-row:2;display:flex;flex-direction:column;gap:12px}"
			& ".rdash .fact{background:#15151a;border:1px solid #2a2a30;border-radius:8px;padding:16px 18px;position:relative;overflow:hidden;animation:fadeInUp 0.5s cubic-bezier(0.16,1,0.3,1) backwards}"
			& ".rdash .fact.f1{animation-delay:0.15s}"
			& ".rdash .fact.f2{animation-delay:0.2s}"
			& ".rdash .fact.f3{animation-delay:0.25s}"
			& ".rdash .fact .accent{position:absolute;left:0;top:0;bottom:0;width:3px}"
			& ".rdash .fact .flabel{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:#888888;font-weight:700;margin-bottom:6px}"
			& ".rdash .fact .fname{font-size:16px;font-weight:700;color:#ffffff;line-height:1.2}"
			& ".rdash .fact .fdetail{font-size:11px;color:#aaaaaa;margin-top:4px;font-family:'JetBrains Mono',monospace}"
			
			// RESULTS TABLE
			& ".rdash .results-panel{grid-column:1/-1;background:#15151a;border:1px solid #2a2a30;border-radius:8px;overflow:hidden;animation:fadeInUp 0.6s cubic-bezier(0.16,1,0.3,1) backwards;animation-delay:0.4s}"
			& ".rdash .rp-head{padding:12px 16px;border-bottom:1px solid #2a2a30;display:flex;justify-content:space-between;align-items:center;background:#1a1a1f}"
			& ".rdash .rp-head h2{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#cccccc;font-weight:700;margin:0;display:flex;align-items:center}"
			& ".rdash .rp-head .accent-dot{width:8px;height:8px;background:#FF1801;border-radius:50%;display:inline-block;margin-right:8px;animation:f1pulse 2s infinite}"
			& ".rdash .rp-head .rp-meta{font-size:10px;color:#888888}"
			
			& ".rdash .rt-head{display:grid;grid-template-columns:50px 60px 1fr 60px 60px 60px 60px 1.2fr;gap:12px;padding:10px 16px;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#888888;font-weight:700;border-bottom:1px solid #2a2a30;background:#1a1a1f}"
			& ".rdash .rt-head .h-c{text-align:center}"
			& ".rdash .rt-head .h-r{text-align:right}"
			
			& ".rdash .rrow{display:grid;grid-template-columns:50px 60px 1fr 60px 60px 60px 60px 1.2fr;gap:12px;padding:10px 16px;align-items:center;border-bottom:1px solid #1f1f24;color:#ffffff;transition:background 0.15s,transform 0.15s;animation:fadeInLeft 0.4s ease-out backwards}"
			& ".rdash .rrow:hover{background:#1f1f24;transform:translateX(2px)}"
			& ".rdash .rrow.dnf{opacity:0.55}"
			& ".rdash .rpos{font-weight:800;font-size:16px;text-align:center;color:#ffffff;font-variant-numeric:tabular-nums}"
			& ".rdash .rcode{font-family:'JetBrains Mono',monospace;font-size:11px;color:#cccccc;letter-spacing:0.05em;background:#0a0a0d;padding:3px 6px;border-radius:3px;text-align:center}"
			& ".rdash .rname{display:flex;flex-direction:column;gap:2px;min-width:0}"
			& ".rdash .rname-main{font-size:13px;font-weight:600;color:#ffffff;display:flex;align-items:center;gap:6px}"
			& ".rdash .rname-sub{font-size:10px;color:#aaaaaa;font-weight:500}"
			& ".rdash .fl-badge{font-size:9px;font-weight:800;background:#9333EA;color:#ffffff;padding:1px 5px;border-radius:2px;letter-spacing:0.05em}"
			& ".rdash .rgrid{font-size:11px;color:#aaaaaa;text-align:center;font-family:'JetBrains Mono',monospace}"
			& ".rdash .rdelta{font-size:11px;text-align:center;font-weight:700;font-variant-numeric:tabular-nums}"
			& ".rdash .delta-up{color:#22C55E}"
			& ".rdash .delta-down{color:#EF4444}"
			& ".rdash .delta-flat{color:#888888}"
			& ".rdash .delta-none{color:#666666}"
			& ".rdash .rlaps{font-size:11px;color:#aaaaaa;text-align:center;font-variant-numeric:tabular-nums}"
			& ".rdash .rpts{font-size:14px;font-weight:800;color:#ffffff;text-align:right;font-variant-numeric:tabular-nums}"
			& ".rdash .rstat{font-size:11px;color:#aaaaaa;text-align:left;font-style:italic}"
			
			& ".rdash .empty{padding:60px;text-align:center;color:#888888;font-size:13px}"
			& "</style>"
			
			& "<div class='rdash'>"
			
			// HEADER
			& "<div class='rhead'>"
			    & "<div class='rh-left'>"
			        & "<div class='rh-bar'></div>"
			        & "<div class='rh-titles'>"
			            & "<div class='rh-rname'>" & IF ( ISBLANK ( EffectiveRaceName ), "Select a race", EffectiveRaceName ) & "</div>"
			            & "<div class='rh-meta'>ROUND " & EffectiveRound & " · " & UPPER ( IF ( ISBLANK ( EffectiveCountry ), "—", EffectiveCountry ) )
			                & " · " & FORMAT ( EffectiveDate, "DD MMM YYYY" ) & "</div>"
			        & "</div>"
			    & "</div>"
			    & "<div class='rh-right'>"
			        & "<div class='rh-stat'><div class='v'>" & TotalLaps & "</div><div class='l'>Laps</div></div>"
			        & "<div class='rh-stat'><div class='v'>" & DriversFinished & "</div><div class='l'>Finished</div></div>"
			        & "<div class='rh-stat'><div class='v'>" & DriversDNF & "</div><div class='l'>DNFs</div></div>"
			    & "</div>"
			& "</div>"
			
			// PODIUM
			& "<div class='podium-panel'>"
			    & IF ( ISBLANK ( P1Name ),
			        "<div class='empty' style='height:280px;display:flex;align-items:center;justify-content:center'>No race data available</div>",
			        "<div class='podium'>"
			            // P2
			            & "<div class='pblock b2'>"
			                & "<div class='pcard'>"
			                    & "<div class='pnum' style='background:" & IF ( ISBLANK ( P2Color ), "#888", P2Color ) & "'>" & IF ( ISBLANK ( P2Number ), "—", P2Number ) & "</div>"
			                    & "<div class='pn'>" & IF ( ISBLANK ( P2Name ), "—", P2Name ) & "</div>"
			                    & "<div class='pt' style='color:" & IF ( ISBLANK ( P2Color ), "#aaa", P2Color ) & "'>" & IF ( ISBLANK ( P2Team ), "—", P2Team ) & "</div>"
			                    & "<div class='ptm'>" & IF ( ISBLANK ( P2Time ), "", P2Time ) & "</div>"
			                & "</div>"
			                & "<div class='pstand s2'>2</div>"
			            & "</div>"
			            // P1
			            & "<div class='pblock b1'>"
			                & "<div class='pcard'>"
			                    & "<div class='pnum' style='background:" & IF ( ISBLANK ( P1Color ), "#888", P1Color ) & "'>" & IF ( ISBLANK ( P1Number ), "—", P1Number ) & "</div>"
			                    & "<div class='pn'>" & IF ( ISBLANK ( P1Name ), "—", P1Name ) & "</div>"
			                    & "<div class='pt' style='color:" & IF ( ISBLANK ( P1Color ), "#aaa", P1Color ) & "'>" & IF ( ISBLANK ( P1Team ), "—", P1Team ) & "</div>"
			                    & "<div class='ptm'>" & IF ( ISBLANK ( P1Time ), "", P1Time ) & "</div>"
			                & "</div>"
			                & "<div class='pstand s1'>1</div>"
			            & "</div>"
			            // P3
			            & "<div class='pblock b3'>"
			                & "<div class='pcard'>"
			                    & "<div class='pnum' style='background:" & IF ( ISBLANK ( P3Color ), "#888", P3Color ) & "'>" & IF ( ISBLANK ( P3Number ), "—", P3Number ) & "</div>"
			                    & "<div class='pn'>" & IF ( ISBLANK ( P3Name ), "—", P3Name ) & "</div>"
			                    & "<div class='pt' style='color:" & IF ( ISBLANK ( P3Color ), "#aaa", P3Color ) & "'>" & IF ( ISBLANK ( P3Team ), "—", P3Team ) & "</div>"
			                    & "<div class='ptm'>" & IF ( ISBLANK ( P3Time ), "", P3Time ) & "</div>"
			                & "</div>"
			                & "<div class='pstand s3'>3</div>"
			            & "</div>"
			        & "</div>"
			    )
			& "</div>"
			
			// FACT CARDS
			& "<div class='facts-col'>"
			    & "<div class='fact f1'>"
			        & "<div class='accent' style='background:" & IF ( ISBLANK ( FLTeamColor ), "#9333EA", FLTeamColor ) & "'></div>"
			        & "<div class='flabel'>Fastest Lap</div>"
			        & "<div class='fname'>" & IF ( ISBLANK ( FLDriver ), "—", FLDriver ) & "</div>"
			        & "<div class='fdetail'>" & IF ( ISBLANK ( FLTime ), "—", FLTime ) & " · LAP " & IF ( ISBLANK ( FLLap ), "—", FLLap ) & "</div>"
			    & "</div>"
			    & "<div class='fact f2'>"
			        & "<div class='accent' style='background:#22C55E'></div>"
			        & "<div class='flabel'>Pole Position</div>"
			        & "<div class='fname'>" & IF ( ISBLANK ( PoleDriver ), "—", PoleDriver ) & "</div>"
			        & "<div class='fdetail'>STARTED P1</div>"
			    & "</div>"
			    & "<div class='fact f3'>"
			        & "<div class='accent' style='background:#3671C6'></div>"
			        & "<div class='flabel'>Circuit</div>"
			        & "<div class='fname'>" & IF ( ISBLANK ( EffectiveCircuit ), "—", EffectiveCircuit ) & "</div>"
			        & "<div class='fdetail'>" & UPPER ( IF ( ISBLANK ( EffectiveCity ), "—", EffectiveCity ) ) & ", " & UPPER ( IF ( ISBLANK ( EffectiveCountry ), "—", EffectiveCountry ) ) & "</div>"
			    & "</div>"
			& "</div>"
			
			// FULL RESULTS TABLE
			& "<div class='results-panel'>"
			    & "<div class='rp-head'>"
			        & "<h2><span class='accent-dot'></span>Full Results</h2>"
			        & "<span class='rp-meta'>20 ENTRIES</span>"
			    & "</div>"
			    & "<div class='rt-head'>"
			        & "<div class='h-c'>POS</div>"
			        & "<div class='h-c'>CODE</div>"
			        & "<div>DRIVER</div>"
			        & "<div class='h-c'>GRID</div>"
			        & "<div class='h-c'>+/-</div>"
			        & "<div class='h-c'>LAPS</div>"
			        & "<div class='h-r'>PTS</div>"
			        & "<div>STATUS</div>"
			    & "</div>"
			    & IF ( ISBLANK ( ResultsRowsHTML ),
			        "<div class='empty'>No race data for this round.</div>",
			        ResultsRowsHTML )
			& "</div>"
			
			& "</div>"
		lineageTag: 25a720c9-9a08-44ee-979d-79f3302d8561

	measure 'Race Analysis HTML' =
			
			
			// ---------- SELECTED RACE ----------
			VAR SelRound = SELECTEDVALUE ( Races[Round] )
			VAR EffectiveRound =
			    IF (
			        ISBLANK ( SelRound ),
			        CALCULATE ( MAX ( Results[Round] ), ALL ( Races ) ),
			        SelRound
			    )
			VAR EffectiveRaceName =
			    CALCULATE ( MAX ( Races[RaceName] ), Races[Round] = EffectiveRound, ALL ( Races ) )
			VAR EffectiveCountry =
			    CALCULATE ( MAX ( Races[Country] ), Races[Round] = EffectiveRound, ALL ( Races ) )
			
			// ---------- DATA SCOPE ----------
			VAR LapData =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Lap Positions',
			            'Lap Positions'[DriverId],
			            'Lap Positions'[Lap],
			            'Lap Positions'[Position]
			        ),
			        'Lap Positions'[Round] = EffectiveRound,
			        ALL ( Races )
			    )
			VAR TotalLaps = MAXX ( LapData, 'Lap Positions'[Lap] )
			VAR DriversInRace =
			    CALCULATETABLE (
			        VALUES ( 'Lap Positions'[DriverId] ),
			        'Lap Positions'[Round] = EffectiveRound,
			        ALL ( Races )
			    )
			
			// ---------- SVG GEOMETRY ----------
			VAR ChartW = 1100
			VAR ChartH = 480
			VAR PadL = 40
			VAR PadR = 200
			VAR PadT = 20
			VAR PadB = 30
			VAR PlotW = ChartW - PadL - PadR
			VAR PlotH = ChartH - PadT - PadB
			VAR XStep = DIVIDE ( PlotW, TotalLaps - 1, 0 )
			VAR YStep = DIVIDE ( PlotH, 19, 0 )
			
			// ---------- BUILD POLYLINES (one per driver) ----------
			VAR DriverInfo =
			    ADDCOLUMNS (
			        DriversInRace,
			        "@FinalPos",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            RETURN
			                CALCULATE (
			                    MAX ( Results[Position] ),
			                    Results[Round] = EffectiveRound,
			                    Results[DriverId] = ThisDriver,
			                    ALL ( Races )
			                ),
			        "@Code",
			            LOOKUPVALUE ( Drivers[DriverCode], Drivers[DriverId], 'Lap Positions'[DriverId] ),
			        "@Name",
			            LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], 'Lap Positions'[DriverId] ),
			        "@Color",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            VAR ConId =
			                CALCULATE (
			                    MAX ( Results[ConstructorId] ),
			                    Results[Round] = EffectiveRound,
			                    Results[DriverId] = ThisDriver,
			                    ALL ( Races )
			                )
			            RETURN
			                CALCULATE (
			                    MAX ( Constructors[TeamColor] ),
			                    Constructors[ConstructorId] = ConId,
			                    ALL ( Constructors )
			                )
			    )
			VAR DriverEnriched = DriverInfo
			VAR DriverPolylines =
			    ADDCOLUMNS (
			        DriverEnriched,
			        "@Points",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            VAR DriverLaps =
			                CALCULATETABLE (
			                    SUMMARIZE ( 'Lap Positions', 'Lap Positions'[Lap], 'Lap Positions'[Position] ),
			                    'Lap Positions'[Round] = EffectiveRound,
			                    'Lap Positions'[DriverId] = ThisDriver,
			                    ALL ( Races )
			                )
			            RETURN
			                CONCATENATEX (
			                    DriverLaps,
			                    VAR X = PadL + ( 'Lap Positions'[Lap] - 1 ) * XStep
			                    VAR Y = PadT + ( 'Lap Positions'[Position] - 1 ) * YStep
			                    RETURN FORMAT ( X, "0.0" ) & "," & FORMAT ( Y, "0.0" ),
			                    " ",
			                    'Lap Positions'[Lap], ASC
			                ),
			        "@FinalY",
			            PadT + ( [@FinalPos] - 1 ) * YStep
			    )
			
			// ---------- BUILD SVG ELEMENTS ----------
			VAR PolylinesSvg =
			    CONCATENATEX (
			        DriverPolylines,
			        VAR ThisDriver = 'Lap Positions'[DriverId]
			        VAR ThisConId =
			            CALCULATE (
			                MAX ( Results[ConstructorId] ),
			                Results[Round] = EffectiveRound,
			                Results[DriverId] = ThisDriver,
			                ALL ( Races )
			            )
			        VAR ThisColor =
			            CALCULATE (
			                MAX ( Constructors[TeamColor] ),
			                Constructors[ConstructorId] = ThisConId,
			                ALL ( Constructors )
			            )
			        VAR SafeColor = IF ( ISBLANK ( ThisColor ), "#888", ThisColor )
			        // End cap geometry — last lap and position the driver actually completed
			        VAR LastLap =
			            CALCULATE (
			                MAX ( 'Lap Positions'[Lap] ),
			                'Lap Positions'[Round] = EffectiveRound,
			                'Lap Positions'[DriverId] = ThisDriver,
			                ALL ( Races )
			            )
			        VAR LastPos =
			            CALCULATE (
			                MAX ( 'Lap Positions'[Position] ),
			                'Lap Positions'[Round] = EffectiveRound,
			                'Lap Positions'[DriverId] = ThisDriver,
			                'Lap Positions'[Lap] = LastLap,
			                ALL ( Races )
			            )
			        VAR EndX = PadL + ( LastLap - 1 ) * XStep
			        VAR EndY = PadT + ( LastPos - 1 ) * YStep
			        // Detect DNF — if last lap < total race laps, driver retired
			        VAR IsDNF = LastLap < TotalLaps
			        VAR LineDash = IF ( IsDNF, "stroke-dasharray:6,3;", "" )
			        // Label X position — at end of driver's actual line, not at chart edge
			        VAR LabelX = IF ( IsDNF, EndX + 6, PadL + PlotW + 6 )
			        VAR LabelY = IF ( IsDNF, EndY + 4, PadT + ( [@FinalPos] - 1 ) * YStep + 4 )
			        RETURN
			            // Polyline (the lap-by-lap trace)
			            "<polyline class='lap-line' data-driver='" & ThisDriver
			                & "' points='" & [@Points] & "' "
			                & "style='stroke:" & SafeColor & ";stroke-width:2;fill:none;stroke-linejoin:round;stroke-linecap:round;" & LineDash & "' />"
			            // End cap circle at last position
			            & "<circle class='lap-endcap' cx='" & FORMAT ( EndX, "0.0" )
			                & "' cy='" & FORMAT ( EndY, "0.0" )
			                & "' r='3.5' style='fill:" & SafeColor
			                & ";stroke:#0a0a0d;stroke-width:1.5' />"
			            // Driver label — for DNFs, label at retirement point; for finishers, at right edge
			            & "<text class='lap-label' x='" & FORMAT ( LabelX, "0.0" )
			                & "' y='" & FORMAT ( LabelY, "0.0" )
			                & "' style='fill:" & SafeColor & "'>"
			                & IF ( IsDNF, "DNF L" & LastLap & " " & [@Code], "P" & [@FinalPos] & " " & [@Code] )
			                & "</text>",
			        ""
			    )
			VAR YAxisSvg =
			    "<line x1='" & PadL & "' y1='" & PadT & "' x2='" & PadL & "' y2='" & ( PadT + PlotH ) & "' stroke='#2a2a30' stroke-width='1' />"
			    & CONCATENATEX (
			        { 1, 5, 10, 15, 20 },
			        VAR P = [Value]
			        VAR Y = PadT + ( P - 1 ) * YStep
			        RETURN
			            "<line x1='" & PadL & "' y1='" & Y & "' x2='" & ( PadL + PlotW ) & "' y2='" & Y
			            & "' stroke='#1f1f24' stroke-width='1' stroke-dasharray='2,4' />"
			            & "<text x='" & ( PadL - 8 ) & "' y='" & ( Y + 4 ) & "' fill='#888' font-size='10' text-anchor='end'>P" & P & "</text>",
			        ""
			    )
			
			VAR XAxisLabelsList = GENERATESERIES ( 1, TotalLaps, 5 )
			VAR XAxisSvg =
			    "<line x1='" & PadL & "' y1='" & ( PadT + PlotH ) & "' x2='" & ( PadL + PlotW ) & "' y2='" & ( PadT + PlotH ) & "' stroke='#2a2a30' stroke-width='1' />"
			    & CONCATENATEX (
			        XAxisLabelsList,
			        VAR L = [Value]
			        VAR X = PadL + ( L - 1 ) * XStep
			        RETURN
			            "<text x='" & FORMAT ( X, "0.0" ) & "' y='" & ( PadT + PlotH + 16 ) & "' fill='#888' font-size='10' text-anchor='middle'>L" & L & "</text>",
			        ""
			    )
			
			// ---------- OVERTAKE COUNT ----------
			VAR PositionChangeData =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Lap Positions',
			            'Lap Positions'[Lap],
			            'Lap Positions'[DriverId],
			            'Lap Positions'[Position]
			        ),
			        'Lap Positions'[Round] = EffectiveRound,
			        ALL ( Races )
			    )
			VAR Overtakes =
			    SUMX (
			        FILTER ( PositionChangeData, 'Lap Positions'[Lap] > 1 ),
			        VAR ThisLap = 'Lap Positions'[Lap]
			        VAR ThisDriver = 'Lap Positions'[DriverId]
			        VAR ThisPos = 'Lap Positions'[Position]
			        VAR PrevPos =
			            MAXX (
			                FILTER (
			                    PositionChangeData,
			                    'Lap Positions'[Lap] = ThisLap - 1
			                        && 'Lap Positions'[DriverId] = ThisDriver
			                ),
			                'Lap Positions'[Position]
			            )
			        RETURN IF ( NOT ISBLANK ( PrevPos ) && ThisPos < PrevPos, PrevPos - ThisPos, 0 )
			    )
			
			// ---------- BIGGEST MOVER ----------
			VAR MoverInfo =
			    ADDCOLUMNS (
			        DriversInRace,
			        "@StartPos",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            RETURN
			                CALCULATE (
			                    MAX ( 'Lap Positions'[Position] ),
			                    'Lap Positions'[Round] = EffectiveRound,
			                    'Lap Positions'[Lap] = 1,
			                    'Lap Positions'[DriverId] = ThisDriver,
			                    ALL ( Races )
			                ),
			        "@FinalPos",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            RETURN
			                CALCULATE (
			                    MAX ( Results[Position] ),
			                    Results[Round] = EffectiveRound,
			                    Results[DriverId] = ThisDriver,
			                    ALL ( Races )
			                )
			    )
			VAR MoverWithDelta =
			    ADDCOLUMNS (
			        MoverInfo,
			        "@Delta", IF ( NOT ISBLANK ( [@StartPos] ) && NOT ISBLANK ( [@FinalPos] ),
			            [@StartPos] - [@FinalPos], BLANK () )
			    )
			VAR MaxDelta = MAXX ( MoverWithDelta, [@Delta] )
			VAR BiggestMoverId =
			    MAXX (
			        FILTER ( MoverWithDelta, [@Delta] = MaxDelta && NOT ISBLANK ( MaxDelta ) ),
			        'Lap Positions'[DriverId]
			    )
			VAR BiggestMoverName =
			    LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], BiggestMoverId )
			
			// ---------- MOST LAPS LED ----------
			VAR LapsLedData =
			    ADDCOLUMNS (
			        DriversInRace,
			        "@LapsLed",
			            VAR ThisDriver = 'Lap Positions'[DriverId]
			            RETURN
			                CALCULATE (
			                    COUNTROWS ( 'Lap Positions' ),
			                    'Lap Positions'[Round] = EffectiveRound,
			                    'Lap Positions'[Position] = 1,
			                    'Lap Positions'[DriverId] = ThisDriver,
			                    ALL ( Races )
			                )
			    )
			VAR MaxLapsLed = MAXX ( LapsLedData, [@LapsLed] )
			VAR LeaderId =
			    MAXX (
			        FILTER ( LapsLedData, [@LapsLed] = MaxLapsLed && NOT ISBLANK ( MaxLapsLed ) ),
			        'Lap Positions'[DriverId]
			    )
			VAR LeaderName =
			    LOOKUPVALUE ( Drivers[DriverName], Drivers[DriverId], LeaderId )
			
			// ---------- ASSEMBLE ----------
			RETURN
			"<style>"
			& ".radash *{box-sizing:border-box;margin:0;padding:0;font-family:'Inter','Segoe UI',-apple-system,sans-serif;-webkit-font-smoothing:antialiased}"
			& ".radash{display:grid;grid-template-columns:repeat(12,1fr);grid-gap:14px;padding:18px;background:#0a0a0d;min-height:100vh;color:#ffffff}"
			& "@keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}"
			& "@keyframes drawLine{from{stroke-dashoffset:3000}to{stroke-dashoffset:0}}"
			& "@keyframes f1pulse{0%,100%{opacity:1}50%{opacity:0.4}}"
			& ".radash .rahead{grid-column:1/-1;display:flex;align-items:center;padding:6px 4px 16px;border-bottom:1px solid #2a2a30;animation:fadeInUp 0.5s ease-out backwards}"
			& ".radash .rh-left{display:flex;align-items:center;gap:14px}"
			& ".radash .rh-bar{width:5px;height:48px;background:#FF1801;border-radius:2px}"
			& ".radash .rh-titles .rh-rname{font-size:24px;font-weight:800;letter-spacing:-0.01em;color:#ffffff;line-height:1.1}"
			& ".radash .rh-titles .rh-meta{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#aaaaaa;margin-top:6px;font-weight:600}"
			& ".radash .chart-panel{grid-column:1/-1;background:#15151a;border:1px solid #2a2a30;border-radius:8px;overflow:hidden;animation:fadeInUp 0.6s ease-out backwards;animation-delay:0.1s}"
			& ".radash .panel-head{padding:12px 16px;border-bottom:1px solid #2a2a30;display:flex;justify-content:space-between;align-items:center;background:#1a1a1f}"
			& ".radash .panel-head h2{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#cccccc;font-weight:700;display:flex;align-items:center;margin:0}"
			& ".radash .panel-head .accent-dot{width:8px;height:8px;background:#FF1801;border-radius:50%;display:inline-block;margin-right:8px;animation:f1pulse 2s infinite}"
			& ".radash .panel-head .meta{font-size:10px;color:#888888}"
			& ".radash .chart-body{padding:18px}"
			& ".radash svg{width:100%;height:auto;display:block}"
			& ".radash .lap-line{transition:opacity 0.2s,stroke-width 0.2s;stroke-dasharray:3000;stroke-dashoffset:3000;animation:drawLine 1.4s ease-out forwards;animation-delay:0.3s}"
			& ".radash svg:hover .lap-line{opacity:0.18}"
			& ".radash svg .lap-line:hover{opacity:1;stroke-width:3.5}"
			& ".radash .lap-label{font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;opacity:0;animation:fadeInUp 0.4s ease-out forwards;animation-delay:1.6s}"
			& ".radash .insights{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}"
			& ".radash .ins{background:#15151a;border:1px solid #2a2a30;border-radius:8px;padding:18px;position:relative;overflow:hidden;animation:fadeInUp 0.6s ease-out backwards}"
			& ".radash .ins.i1{animation-delay:0.4s}"
			& ".radash .ins.i2{animation-delay:0.5s}"
			& ".radash .ins.i3{animation-delay:0.6s}"
			& ".radash .ins .accent{position:absolute;left:0;top:0;bottom:0;width:3px}"
			& ".radash .ins .ilabel{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:#888888;font-weight:700;margin-bottom:8px}"
			& ".radash .ins .ivalue{font-size:28px;font-weight:800;color:#ffffff;line-height:1;font-variant-numeric:tabular-nums}"
			& ".radash .ins .iname{font-size:14px;font-weight:600;color:#ffffff;line-height:1.2;margin-top:4px}"
			& ".radash .ins .isub{font-size:11px;color:#aaaaaa;margin-top:6px}"
			& ".radash .empty{padding:60px;text-align:center;color:#888888;font-size:13px}"
			& "</style>"
			& "<div class='radash'>"
			& "<div class='rahead'>"
			    & "<div class='rh-left'>"
			        & "<div class='rh-bar'></div>"
			        & "<div class='rh-titles'>"
			            & "<div class='rh-rname'>" & IF ( ISBLANK ( EffectiveRaceName ), "Select a race", EffectiveRaceName ) & "</div>"
			            & "<div class='rh-meta'>RACE ANALYSIS · ROUND " & EffectiveRound & " · " & UPPER ( IF ( ISBLANK ( EffectiveCountry ), "—", EffectiveCountry ) ) & "</div>"
			        & "</div>"
			    & "</div>"
			& "</div>"
			& "<div class='chart-panel'>"
			    & "<div class='panel-head'>"
			        & "<h2><span class='accent-dot'></span>Lap-by-Lap Position Chart</h2>"
			        & "<span class='meta'>HOVER A LINE TO ISOLATE</span>"
			    & "</div>"
			    & "<div class='chart-body'>"
			    & IF ( ISBLANK ( TotalLaps ),
			        "<div class='empty'>No lap data available for this race.</div>",
			        "<svg viewBox='0 0 " & ChartW & " " & ChartH & "' xmlns='http://www.w3.org/2000/svg'>"
			            & YAxisSvg
			            & XAxisSvg
			            & PolylinesSvg
			        & "</svg>"
			    )
			    & "</div>"
			& "</div>"
			& "<div class='insights'>"
			    & "<div class='ins i1'>"
			        & "<div class='accent' style='background:#FFCC00'></div>"
			        & "<div class='ilabel'>Most Laps Led</div>"
			        & "<div class='ivalue'>" & IF ( ISBLANK ( MaxLapsLed ), "—", MaxLapsLed ) & "</div>"
			        & "<div class='iname'>" & IF ( ISBLANK ( LeaderName ), "—", LeaderName ) & "</div>"
			        & "<div class='isub'>laps in the lead</div>"
			    & "</div>"
			    & "<div class='ins i2'>"
			        & "<div class='accent' style='background:#22C55E'></div>"
			        & "<div class='ilabel'>Biggest Mover</div>"
			        & "<div class='ivalue'>+" & IF ( ISBLANK ( MaxDelta ), "—", MaxDelta ) & "</div>"
			        & "<div class='iname'>" & IF ( ISBLANK ( BiggestMoverName ), "—", BiggestMoverName ) & "</div>"
			        & "<div class='isub'>positions gained</div>"
			    & "</div>"
			    & "<div class='ins i3'>"
			        & "<div class='accent' style='background:#FF1801'></div>"
			        & "<div class='ilabel'>Position Changes</div>"
			        & "<div class='ivalue'>" & Overtakes & "</div>"
			        & "<div class='iname'>Total overtakes</div>"
			        & "<div class='isub'>net forward moves across all drivers</div>"
			    & "</div>"
			& "</div>"
			& "</div>"
		lineageTag: 20a3a7e6-95a9-4df9-9de8-afbdee8eb3a5

	column Column
		dataType: string
		isHidden
		lineageTag: c0a436af-4228-4c5e-8543-adbb6127f5d1
		summarizeBy: none
		sourceColumn: Column

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

